        "custom_liquid_XMeAWr": {
          "type": "custom_liquid",
          "name": "Countdown",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- Compact Elegant Countdown Timer with Bold Digits -->\n<div class=\"countdown-container\">\n  <span class=\"countdown-label\">Offer Ends </span>\n  <div id=\"countdown\" class=\"countdown-display\"></div>\n</div>\n\n<!-- Styles -->\n<style>\n  .countdown-container {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-weight: 500;\n    font-family: var(--font-body-family);\n    padding: 6px 0;\n  }\n  \n  .countdown-label {\n    color: #00324C;\n    font-weight: 600;\n    font-size: 16px;\n    letter-spacing: 0.3px;\n  }\n  \n  .countdown-display {\n    display: flex;\n    gap: 5px;\n    align-items: center;\n  }\n  \n  .time-segment {\n    display: flex;\n    gap: 0px;\n    border-radius: 5px;\n    overflow: hidden;\n  }\n  \n  .flip-digit {\n    background-color: #00324C;\n    color: white;\n    min-width: 20px;\n    height: 26px;\n    font-size: 14px;\n    font-family: 'Courier New', monospace;\n    font-weight: 700; /* Made digits bold */\n    border-radius: 0px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    overflow: hidden;\n\n    &:first-child{\n      place-content: end;\n      padding-right: 2px;\n    }\n    &:last-child{\n      place-content: start;\n      padding-left: 2px;\n    }\n  }\n  \n  .digit-inner {\n    line-height: 1rem;\n    display: block;\n    transform-origin: bottom;\n    backface-visibility: hidden;\n    transform: rotateX(0deg);\n    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n    font-weight: inherit; /* Inherit boldness */\n  }\n  \n  .flipping {\n    animation: flip 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n  }\n  \n  @keyframes flip {\n    0% {\n      transform: rotateX(0deg);\n    }\n    50% {\n      transform: rotateX(-90deg);\n    }\n    100% {\n      transform: rotateX(0deg);\n    }\n  }\n  \n  .time-separator {\n    color: #666;\n    font-size: 14px;\n    font-weight: bold;\n    margin: 0 1px;\n    align-self: flex-end;\n    padding-bottom: 2px;\n  }\n</style>\n\n<!-- Script (unchanged from previous version) -->\n<script>\n  const config = {\n    animateAllDigits: false,\n    endOfDay: true\n  };\n  \n  const countdownEl = document.getElementById('countdown');\n  let previousValues = [\"00\", \"00\", \"00\", \"00\"];\n  let digitElements = [];\n  \n  function initTimer() {\n    countdownEl.innerHTML = '';\n    digitElements = [];\n    \n    const timeUnits = ['days', 'hours', 'minutes', 'seconds'];\n    \n    timeUnits.forEach((unit, index) => {\n      if (index > 0) {\n        const separator = document.createElement('span');\n        separator.className = 'time-separator';\n        separator.textContent = ':';\n        countdownEl.appendChild(separator);\n      }\n      \n      const segment = document.createElement('div');\n      segment.className = 'time-segment';\n      \n      for (let i = 0; i < 2; i++) {\n        const digit = document.createElement('div');\n        digit.className = 'flip-digit';\n        \n        const inner = document.createElement('span');\n        inner.className = 'digit-inner';\n        inner.textContent = '0';\n        \n        digit.appendChild(inner);\n        segment.appendChild(digit);\n        digitElements.push(inner);\n      }\n      \n      countdownEl.appendChild(segment);\n    });\n  }\n  \n  function updateTimer() {\n    const now = new Date();\n    let end = new Date();\n    \n    if (config.endOfDay) {\n      end.setHours(23, 59, 59, 999);\n    } else {\n      end = new Date(now.getTime() + 24 * 60 * 60 * 1000);\n    }\n    \n    let diff = end - now;\n    if (diff < 0) diff = 0;\n    \n    const seconds = Math.floor((diff / 1000) % 60);\n    const minutes = Math.floor((diff / 1000 / 60) % 60);\n    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);\n    const days = Math.floor(diff / (1000 * 60 * 60 * 24));\n    \n    const format = (num) => num.toString().padStart(2, '0');\n    const values = [format(days), format(hours), format(minutes), format(seconds)];\n    \n    values.forEach((val, i) => {\n      const tensDigit = val[0];\n      const unitsDigit = val[1];\n      const prevVal = previousValues[i];\n      \n      if (tensDigit !== prevVal[0]) {\n        const tensElement = digitElements[i * 2];\n        tensElement.textContent = tensDigit;\n        if (config.animateAllDigits || i === 3) {\n          tensElement.classList.add('flipping');\n          setTimeout(() => tensElement.classList.remove('flipping'), 600);\n        }\n      }\n      \n      if (unitsDigit !== prevVal[1]) {\n        const unitsElement = digitElements[i * 2 + 1];\n        unitsElement.textContent = unitsDigit;\n        if (config.animateAllDigits || i === 3) {\n          unitsElement.classList.add('flipping');\n          setTimeout(() => unitsElement.classList.remove('flipping'), 600);\n        }\n      }\n    });\n    \n    previousValues = values;\n  }\n  \n  initTimer();\n  updateTimer();\n  setInterval(updateTimer, 1000);\n</script>"
          }
