    "collapsible_content_pDahx6": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_rV7GcY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is Mastt jewellery safe for sensitive skin?",
            "icon": "none",
            "row_content": "<p>Yes — every piece is built on hypoallergenic, surgical-grade stainless steel, with no lead, nickel, or cadmium. Look good without the itch.</p>",
            "page": ""
          }
        },
        "collapsible_row_rFKTLK": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is Mastt jewellery made of?",
            "icon": "none",
            "row_content": "<p>Surgical-grade stainless steel with a thick, richly bonded gold-tone finish — chosen for how it wears over months, not just how it photographs on day one.</p>",
            "page": ""
          }
        },
        "collapsible_row_areCkR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will my Mastt pieces tarnish over time?",
            "icon": "none",
            "row_content": "<p>Stainless steel doesn't tarnish the way plated brass does. Keep your pieces dry, away from perfume and harsh chemicals, and they'll stay looking as good as day one.</p>",
            "page": ""
          }
        },
        "collapsible_row_ek6BJN": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I take care of my jewellery?",
            "icon": "none",
            "row_content": "<p>Wipe gently with a soft, dry cloth after wearing, store pieces separately so they don't scratch each other, and take them off before swimming, showering, or applying lotion.</p>",
            "page": ""
          }
        },
        "collapsible_row_tnMC43": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you make jewellery for men and women?",
            "icon": "none",
            "row_content": "<p>Both. Our rings, necklaces and bracelets are designed for men and women, all held to the same standard of comfort and craft.</p>",
            "page": ""
          }
        },
        "collapsible_row_Dwckk6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is it solid gold?",
            "icon": "none",
            "row_content": "<p>No, and we won't pretend otherwise. Every piece is stainless steel with a premium gold-tone finish — the look and the longevity, without the fine-jewellery price. Every listing says exactly what you're getting.</p>",
            "page": ""
          }
        },
        "collapsible_row_cXPVfi": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I wear Mastt jewellery every day?",
            "icon": "none",
            "row_content": "<p>That's exactly what it's made for. Durable, skin-safe, and designed to move from your morning coffee to your evening plans without a second thought.</p>",
            "page": ""
          }
        },
        "collapsible_row_RLKHHe": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes Mastt different?",
            "icon": "none",
            "row_content": "<p>We sit in the gap between 'expensive fine jewellery' and 'cheap imitation' — pieces that feel considered and last, priced so you can actually build a collection. Look good, feel Mastt.</p>",
            "page": ""
          }
        },
        "collapsible_row_aUkNVy": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How is my order packaged?",
            "icon": "none",
            "row_content": "<p>Every piece arrives in gift-ready packaging with simple care instructions tucked inside — so it's ready to keep or hand straight to someone else.</p>",
            "page": ""
          }
        },
        "collapsible_row_684tT4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Something's wrong with my order — what now?",
            "icon": "none",
            "row_content": "<p>Reach out to Mastt Cares at info@mastt.co and we'll sort it quickly. Your satisfaction matters more to us than being right.</p>",
            "page": ""
          }
        }
      },
