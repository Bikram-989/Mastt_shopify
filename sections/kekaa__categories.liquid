<style>
/* Category tiles — square photo with a soft corner radius, caption beneath.
   Mobile leads: three across with a tight gutter so the row reads as one
   band of choices rather than two big cards you have to scroll past. */

.section-{{ section.id }} .collection-list__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  /* Row gap larger than the column gap: the caption sits under each tile, so
     without it the next row's image crowds the label above it. */
  gap: 20px 8px;
  margin: 0 auto;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }} .collection-list__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(26px, 18px + 1.6vw, 38px) clamp(14px, 9px + 1.2vw, 24px);
    max-width: clamp(600px, 411.1111px + 27.7778vw, 800px);
  }
}

@media screen and (min-width: 1401px) {
  .section-{{ section.id }} .collection-list__grid {
    grid-template-columns: repeat(6, 1fr);
    max-width: none;
  }
}

.collection-list__card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  overflow: visible;
  border-radius: 0;
  background: none;
  box-shadow: none;
  text-decoration: none;
  color: inherit;
}

.collection-list__image {
  position: relative;
  inset: auto;
  width: 100%;
  aspect-ratio: 1;
  height: auto;
  margin-bottom: 0;
  border-radius: var(--radius-md, 16px);
  overflow: hidden;
  background: var(--color-pearl-beige, #F5E7DF);
  /* A drawn black frame rather than a faint tint ring — each category needs
     to read as its own object against the panel behind it. */
  border: 1px solid var(--color-charcoal, #201B19);
  box-shadow: var(--shadow-sm, 0 1px 2px rgba(32, 27, 25, .1));
  transition: transform 420ms cubic-bezier(.16, 1, .3, 1),
              box-shadow 420ms cubic-bezier(.16, 1, .3, 1);
}

@media screen and (min-width: 750px) {
  .collection-list__image { border-radius: var(--radius-lg, 24px); }
  .collection-list__card { gap: clamp(10px, 7px + 0.6vw, 16px); }
}

/* Hover lift is a pointer affordance — skip it on touch, where it only ever
   fires as a sticky state after a tap. */
@media (hover: hover) {
  .collection-list__card:hover .collection-list__image {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md, 0 8px 24px -4px rgba(32, 27, 25, .16)),
                0 0 0 2px var(--tile-ring, var(--color-dusty-coral, #D6887C));
  }
  .collection-list__card:hover .collection-list__image img { transform: scale(1.07); }
  .collection-list__card:hover .collection-list__label { color: var(--color-coral-dark, #B96C60); }
}

.collection-list__card:active .collection-list__image { transform: scale(0.97); }

/* Ring colour cycles through the secondary palette, matching the USP badges */
.collection-list__card:nth-child(4n+1) { --tile-ring: var(--color-dusty-coral, #D6887C); }
.collection-list__card:nth-child(4n+2) { --tile-ring: var(--color-aqua, #78AAB1); }
.collection-list__card:nth-child(4n+3) { --tile-ring: var(--color-blush-pink, #EC9F93); }
.collection-list__card:nth-child(4n+4) { --tile-ring: var(--color-nude-beige, #E3C4BC); }

.collection-list__image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms cubic-bezier(.16, 1, .3, 1);
}

.collection-list__placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.28;
  fill: var(--color-charcoal, #201B19);
  background: linear-gradient(150deg,
              var(--color-pearl-beige, #F5E7DF) 0%,
              var(--color-nude-beige, #E3C4BC) 100%);
}

.collection-list__label {
  position: static;
  display: block;
  text-align: center;
  padding: 0;
  border: none;
  background: none;
  border-radius: 0;
  box-shadow: none;
  place-self: unset;

  font-family: var(--font-body-family);
  font-style: normal;
  font-weight: 500;
  letter-spacing: 0.01em;
  font-size: 12px;
  line-height: 1.3;
  color: var(--color-charcoal, #201B19);
  transition: color 220ms ease;
}

@media screen and (min-width: 750px) {
  .collection-list__label { font-size: clamp(13px, 11px + 0.5vw, 16px); }
}
</style>

<!-- sections/collection-list.liquid -->
<section class="kk-collection-list section-{{ section.id }} kk__wrapper">
  {% if section.settings.title != blank %}
    <h2 class="collection-list__title kk__heading">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="collection-list__grid">
    {% for block in section.blocks %}
      {% assign url = block.settings.collection_url %}
      {% if url != blank %}
        <a href="{{ url }}" class="collection-list__card">
          {%- comment -%}
            Block image first, then the linked collection's own image. Upload
            to the collection in admin and it appears here and in the side
            menu at once — the block picker stays for a one-off override.
          {%- endcomment -%}
          {%- liquid
            assign tile_image = block.settings.image
            if tile_image == blank and url contains '/collections/'
              assign after = url | split: '/collections/' | last
              assign chandle = after | split: '?' | first | split: '#' | first
              assign tile_image = collections[chandle].image
            endif
          -%}
          <div class="collection-list__image">
            {% if tile_image != blank %}
              <img
                src="{{ tile_image | image_url: width: 600 }}"
                alt="{{ block.settings.custom_title | default: 'Visit link' | escape }}"
                loading="lazy"
              >
            {% else %}
              {%- comment -%} Keeps the circle intact until a category photo is uploaded {%- endcomment -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg collection-list__placeholder' }}
            {% endif %}
          </div>

          <span class="collection-list__label">
            {{ block.settings.custom_title | default: "Visit link" }}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>



{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Categories"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Optional. Falls back to the linked collection's own image, which the side menu also uses."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Mastt Collection List",
      "category": "Collections"
    }
  ]
}
{% endschema %}



