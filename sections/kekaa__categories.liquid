<style>
/* Editorial photo tiles — full-bleed image, gradient scrim, caption overlaid at
   the bottom. Same grid/breakpoints and same block.settings.custom_title text,
   only the card's visual treatment changed (was: circular medallion + separate
   outlined pill label below). */

.section-{{ section.id }} .collection-list__grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: clamp(14px, 9px + 1.2vw, 28px);

  margin: 0 auto;
}

@media screen and (max-width: 1400px) {
  .section-{{ section.id }} .collection-list__grid {
    grid-template-columns: repeat(3, 1fr);
    max-width: clamp(600px, 411.1111px + 27.7778vw, 800px);
  }
}

@media screen and (max-width: 679px) {
  .section-{{ section.id }} .collection-list__grid {
    grid-template-columns: repeat(2, 1fr);
    max-width: clamp(300px, 211.1111px + 27.7778vw, 400px);
  }
}

.collection-list__card {
  position: relative;
  display: block;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: var(--radius-lg, 24px);
  background: var(--color-pearl-beige, #F5E7DF);

  text-decoration: none;
  color: inherit;
  box-shadow: var(--shadow-sm, 0 1px 2px rgba(32, 27, 25, .1));
  transition: transform 380ms cubic-bezier(.16, 1, .3, 1),
              box-shadow 380ms cubic-bezier(.16, 1, .3, 1);
}

.collection-list__card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg, 0 20px 48px -8px rgba(32, 27, 25, .2));
}

.collection-list__card::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to top, rgba(32, 27, 25, .78) 0%, rgba(32, 27, 25, 0) 55%);
}

.collection-list__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin-bottom: 0;
  border-radius: 0;
  box-shadow: none;
  overflow: hidden;
}

.collection-list__image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms cubic-bezier(.16, 1, .3, 1);
}

.collection-list__card:hover .collection-list__image img {
  transform: scale(1.07);
}

.collection-list__label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: block;
  text-align: center;
  padding: clamp(14px, 8px + 1vw, 22px) 12px clamp(14px, 8px + 0.8vw, 18px);
  border: none;
  background: none;
  border-radius: 0;
  box-shadow: none;
  place-self: unset;

  font-family: var(--font-heading-family);
  font-style: italic;
  letter-spacing: 0.01em;
  font-size: clamp(15px, 12px + 0.8vw, 20px);
  color: var(--color-pearl-beige, #F5E7DF);
}

@media screen and (max-width: 679px) {
  .collection-list__card { aspect-ratio: 1; }
  .collection-list__label { font-size: 14px; padding: 12px 8px; }
}
</style>

<!-- sections/collection-list.liquid -->
<section class="kk-collection-list section-{{ section.id }} kk__wrapper">
  {% if section.settings.title != blank %}
    <h2 class="collection-list__title kk__heading">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="collection-list__grid">
    {% for block in section.blocks %}
      {% assign url = block.settings.collection_url %}
      {% if url != blank %}
        <a href="{{ url }}" class="collection-list__card">
          {% if block.settings.image %}
            <div class="collection-list__image">
              <img
                src="{{ block.settings.image | img_url: '600x600' }}"
                alt="{{ block.settings.custom_title | default: 'Visit link' | escape }}"
              >
            </div>
          {% endif %}

          <span class="collection-list__label">
            {{ block.settings.custom_title | default: "Visit link" }}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>



{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Categories"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Mastt Collection List",
      "category": "Collections"
    }
  ]
}
{% endschema %}



