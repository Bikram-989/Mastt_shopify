<style>
/* Editorial photo tiles — full-bleed image, gradient scrim, caption overlaid at
   the bottom. Same grid/breakpoints and same block.settings.custom_title text,
   only the card's visual treatment changed (was: circular medallion + separate
   outlined pill label below). */

.section-{{ section.id }} .collection-list__grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: clamp(14px, 9px + 1.2vw, 28px);

  margin: 0 auto;
}

@media screen and (max-width: 1400px) {
  .section-{{ section.id }} .collection-list__grid {
    grid-template-columns: repeat(3, 1fr);
    max-width: clamp(600px, 411.1111px + 27.7778vw, 800px);
  }
}

@media screen and (max-width: 679px) {
  .section-{{ section.id }} .collection-list__grid {
    grid-template-columns: repeat(2, 1fr);
    max-width: clamp(300px, 211.1111px + 27.7778vw, 400px);
  }
}

/* Circular category medallions: the photo fills a perfect circle, the label
   sits beneath it. A soft ring picks up the brand accents on hover. */
.collection-list__card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(10px, 7px + 0.6vw, 16px);
  overflow: visible;
  border-radius: 0;
  background: none;
  box-shadow: none;

  text-decoration: none;
  color: inherit;
}

.collection-list__image {
  position: relative;
  inset: auto;
  width: 100%;
  aspect-ratio: 1;
  height: auto;
  margin-bottom: 0;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-pearl-beige, #F5E7DF);
  box-shadow: var(--shadow-sm, 0 1px 2px rgba(32, 27, 25, .1)),
              0 0 0 1px rgba(32, 27, 25, .06);
  transition: transform 420ms cubic-bezier(.16, 1, .3, 1),
              box-shadow 420ms cubic-bezier(.16, 1, .3, 1);
}

.collection-list__card:hover .collection-list__image {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md, 0 8px 24px -4px rgba(32, 27, 25, .16)),
              0 0 0 2px var(--tile-ring, var(--color-dusty-coral, #D6887C));
}

/* Ring colour cycles through the secondary palette, matching the USP badges */
.collection-list__card:nth-child(4n+1) { --tile-ring: var(--color-dusty-coral, #D6887C); }
.collection-list__card:nth-child(4n+2) { --tile-ring: var(--color-aqua, #78AAB1); }
.collection-list__card:nth-child(4n+3) { --tile-ring: var(--color-blush-pink, #EC9F93); }
.collection-list__card:nth-child(4n+4) { --tile-ring: var(--color-nude-beige, #E3C4BC); }

.collection-list__image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms cubic-bezier(.16, 1, .3, 1);
}

.collection-list__card:hover .collection-list__image img {
  transform: scale(1.07);
}

.collection-list__placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.28;
  fill: var(--color-charcoal, #201B19);
  background: linear-gradient(150deg,
              var(--color-pearl-beige, #F5E7DF) 0%,
              var(--color-nude-beige, #E3C4BC) 100%);
}

.collection-list__label {
  position: static;
  display: block;
  text-align: center;
  padding: 0;
  border: none;
  background: none;
  border-radius: 0;
  box-shadow: none;
  place-self: unset;

  font-family: var(--font-body-family);
  font-style: normal;
  font-weight: 500;
  letter-spacing: 0.01em;
  font-size: clamp(13px, 11px + 0.5vw, 16px);
  color: var(--color-charcoal, #201B19);
  transition: color 220ms ease;
}

.collection-list__card:hover .collection-list__label {
  color: var(--color-coral-dark, #B96C60);
}

@media screen and (max-width: 679px) {
  .collection-list__label { font-size: 13px; }
}
</style>

<!-- sections/collection-list.liquid -->
<section class="kk-collection-list section-{{ section.id }} kk__wrapper">
  {% if section.settings.title != blank %}
    <h2 class="collection-list__title kk__heading">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="collection-list__grid">
    {% for block in section.blocks %}
      {% assign url = block.settings.collection_url %}
      {% if url != blank %}
        <a href="{{ url }}" class="collection-list__card">
          <div class="collection-list__image">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.custom_title | default: 'Visit link' | escape }}"
                loading="lazy"
              >
            {% else %}
              {%- comment -%} Keeps the circle intact until a category photo is uploaded {%- endcomment -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg collection-list__placeholder' }}
            {% endif %}
          </div>

          <span class="collection-list__label">
            {{ block.settings.custom_title | default: "Visit link" }}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>



{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Categories"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Mastt Collection List",
      "category": "Collections"
    }
  ]
}
{% endschema %}



