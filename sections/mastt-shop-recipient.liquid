{%- comment -%}
  Shop by Recipient — two large image cards (e.g. Gifts For Her / For Him).
  Photo optional: falls back to a brand gradient so the section looks finished
  before real photography lands.
{%- endcomment -%}

<style>
  #Recipient-{{ section.id }} {
    padding-block: calc(var(--spacer) / 2);
  }

  #Recipient-{{ section.id }} .msr__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 3 | at_least: 1 }}, minmax(0, 1fr));
    gap: clamp(16px, 10px + 1.4vw, 32px);
  }

  #Recipient-{{ section.id }} .msr__card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-white, #fff);
    border: 1px solid var(--color-charcoal-08, rgba(32,27,25,.08));
    border-radius: var(--radius-lg, 24px);
    padding: clamp(10px, 7px + 0.6vw, 14px);
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(32,27,25,.1));
    transition: transform 380ms cubic-bezier(.16,1,.3,1),
                box-shadow 380ms cubic-bezier(.16,1,.3,1);
  }

  #Recipient-{{ section.id }} .msr__card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg, 0 20px 48px -8px rgba(32,27,25,.22));
  }

  #Recipient-{{ section.id }} .msr__media {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    border-radius: var(--radius-md, 16px);
    background: linear-gradient(150deg,
                var(--color-pearl-beige, #F5E7DF) 0%,
                var(--color-nude-beige, #E3C4BC) 100%);
  }

  #Recipient-{{ section.id }} .msr__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 620ms cubic-bezier(.16,1,.3,1);
  }

  #Recipient-{{ section.id }} .msr__card:hover .msr__media img {
    transform: scale(1.05);
  }

  #Recipient-{{ section.id }} .msr__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.26;
    fill: var(--color-charcoal, #201B19);
  }

  #Recipient-{{ section.id }} .msr__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: clamp(14px, 10px + 0.8vw, 22px) 10px clamp(8px, 6px + 0.4vw, 12px);
    font-family: var(--font-heading-family);
    font-size: clamp(16px, 13px + 0.9vw, 22px);
    color: var(--color-charcoal, #201B19);
  }

  #Recipient-{{ section.id }} .msr__label em {
    font-style: italic;
    font-weight: 500;
  }

  #Recipient-{{ section.id }} .msr__arrow {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-dusty-coral, #D6887C);
    color: var(--color-charcoal, #201B19);
    transition: transform 280ms cubic-bezier(.16,1,.3,1);
  }

  #Recipient-{{ section.id }} .msr__card:hover .msr__arrow {
    transform: translateX(4px);
  }

  #Recipient-{{ section.id }} .msr__arrow svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  /* Two across on mobile: "Gifts For Her" and "Gifts For Him" are a pair of
     choices, and stacking them buried the second one below the fold. */
  @media screen and (max-width: 749px) {
    #Recipient-{{ section.id }} .msr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    #Recipient-{{ section.id }} .msr__card { padding: 8px; }

    #Recipient-{{ section.id }} .msr__media {
      aspect-ratio: 1;
      border-radius: var(--radius-sm, 10px);
    }

    #Recipient-{{ section.id }} .msr__label {
      gap: 0.5rem;
      padding: 10px 4px 4px;
      font-size: 14px;
      text-align: center;
    }

    #Recipient-{{ section.id }} .msr__arrow {
      width: 2rem;
      height: 2rem;
    }

    #Recipient-{{ section.id }} .msr__arrow svg {
      width: 1.1rem;
      height: 1.1rem;
    }
  }
</style>

<div id="Recipient-{{ section.id }}" class="mastt-recipient kk__wrapper page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="kk__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="msr__grid">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '/collections/all' }}"
        class="msr__card"
        {{ block.shopify_attributes }}
      >
        <div class="msr__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.label_strong | default: block.settings.label_light | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg msr__placeholder' }}
          {%- endif -%}
        </div>

        <span class="msr__label">
          <span>
            {{ block.settings.label_light | escape }}
            <em>{{ block.settings.label_strong | escape }}</em>
          </span>
          <span class="msr__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Recipient",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Recipient"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "3 / 4", "label": "Portrait" }
      ],
      "default": "4 / 3"
    }
  ],
  "blocks": [
    {
      "type": "recipient",
      "name": "Recipient card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional — falls back to a brand gradient."
        },
        {
          "type": "text",
          "id": "label_light",
          "label": "Label",
          "default": "Gifts For"
        },
        {
          "type": "text",
          "id": "label_strong",
          "label": "Emphasised word",
          "default": "Her"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Shop by Recipient",
      "blocks": [
        { "type": "recipient" },
        { "type": "recipient" }
      ]
    }
  ]
}
{% endschema %}
