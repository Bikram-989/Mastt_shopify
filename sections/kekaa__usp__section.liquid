<style>
/* Redesigned for Mastt: was a "diamond" icon overlapping a solid backdrop
   panel. Now a quiet trust-strip — ringed icon badges cycling through the
   four secondary brand colors, thin hairline dividers between items on
   desktop, no backdrop panel. Same block loop / settings, visual only. */

h1, h2, h3, p { margin: 0; }

.usp-wrapper {
  padding-block: clamp(48px, 34px + 4vw, 96px);
}

.usp-wrapper .kk__heading {
  text-align: center;
  margin-bottom: clamp(32px, 22px + 3vw, 56px) !important;
}

.usp-container {
  display: grid;
  /* auto-fit so the strip stays balanced whatever the block count */
  grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
  max-width: 1120px;
  margin: 0 auto;
  position: static;
}

.usp {
  position: relative;
  max-width: none;
  background: none;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 4px clamp(14px, 8px + 1.8vw, 32px);
}

.usp:not(:first-child)::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14%;
  height: 72%;
  width: 1px;
  background: rgba(32, 27, 25, .12);
}

.usp-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  position: static;
  width: clamp(64px, 52px + 3vw, 88px);
  aspect-ratio: 1;
  transform: none;
  /* no padding: the artwork fills the ring edge to edge */
  padding: 0;
  overflow: hidden;
  margin-bottom: clamp(14px, 10px + 1vw, 20px);
  background: var(--color-white, #fff);
  border-radius: 50%;
  box-shadow: 0 0 0 3px var(--usp-ring, var(--color-dusty-coral, #D6887C)), var(--shadow-sm);
  transition: transform 320ms cubic-bezier(.16,1,.3,1);
}

.usp:hover .usp-icon {
  transform: translateY(-4px);
}

.usp:nth-child(4n+1) .usp-icon { --usp-ring: var(--color-dusty-coral, #D6887C); }
.usp:nth-child(4n+2) .usp-icon { --usp-ring: var(--color-aqua, #78AAB1); }
.usp:nth-child(4n+3) .usp-icon { --usp-ring: var(--color-blush-pink, #EC9F93); }
.usp:nth-child(4n+4) .usp-icon { --usp-ring: var(--color-nude-beige, #E3C4BC); }

.usp-icon img {
  /* fill the circular frame edge to edge, cropping any surplus canvas the
     source file carries rather than floating small in the middle */
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  aspect-ratio: 1;
  object-fit: cover;
  object-position: center;
  border-radius: 50%;
}

.usp-content {
  display: flex;
  gap: 4px;
  flex-direction: column;
  align-items: center;
  margin-top: 0;
  padding: 0;
  isolation: isolate;
}

.usp-title {
  font-size: clamp(15px, 13px + 0.5vw, 19px);
  font-family: var(--font-heading-family);
  font-style: italic;
  font-weight: 500;
  color: var(--color-charcoal, #201B19);
}

.usp-content p {
  text-align: center;
  font-size: clamp(12px, 11px + 0.3vw, 14px);
  line-height: 1.5em;
  color: var(--color-charcoal-70, #6B5F5B);
  max-width: 24ch;
}

@media (width < 1050px) {
  .usp-container {
    grid-template-columns: repeat(2, 1fr);
    row-gap: clamp(28px, 20px + 2vw, 40px);
  }
  /* two-up: only the right-hand column of each row keeps a divider */
  .usp::before { display: none; }
  .usp:nth-child(even)::before {
    display: block;
    content: '';
    position: absolute;
    left: 0;
    top: 14%;
    height: 72%;
    width: 1px;
    background: rgba(32, 27, 25, .12);
  }
}

/* Mobile: one line of four. A 2x2 grid of large medallions ate a full screen
   for four short trust claims. Banding the strip on white and shrinking the
   badges keeps all four in view at once, which is the only way this section
   does its job — it is scanned in passing, never scrolled through. */
@media screen and (max-width: 749px) {
  .usp-wrapper {
    padding-block: 22px;
  }

  .usp-wrapper .kk__heading {
    margin-bottom: 16px !important;
    font-size: clamp(20px, 17px + 1.4vw, 26px);
  }

  .usp-container {
    grid-template-columns: repeat(4, 1fr);
    row-gap: 0;
    column-gap: 2px;
    background: var(--color-white, #fff);
    border: 1px solid var(--color-charcoal-08, rgba(32,27,25,.08));
    border-radius: var(--radius-md, 16px);
    padding: 14px 6px;
    box-shadow: var(--shadow-sm);
  }

  .usp {
    padding: 0 3px;
  }

  /* Hairlines between every item, not just the even ones. */
  .usp::before,
  .usp:nth-child(even)::before { display: none; }

  .usp:not(:first-child)::before {
    display: block;
    content: '';
    position: absolute;
    left: 0;
    top: 12%;
    height: 76%;
    width: 1px;
    background: rgba(32, 27, 25, .10);
  }

  .usp-icon {
    width: 42px;
    margin-bottom: 8px;
    box-shadow: 0 0 0 2px var(--usp-ring, var(--color-dusty-coral, #D6887C));
  }

  .usp-title {
    font-size: 11.5px;
    line-height: 1.25;
    font-style: normal;
    font-weight: 600;
  }

  /* The descriptions are the first thing to go: at this width they set to
     four cramped lines and push the row past a glance. The titles carry the
     claim on their own. */
  .usp-desc { display: none; }
}

@media screen and (min-width: 480px) and (max-width: 749px) {
  .usp-desc {
    display: block;
    font-size: 10.5px;
    line-height: 1.35;
    max-width: none;
  }
}
</style>

<section class="usp-wrapper kk__wrapper">
  <h2 class="kk__heading">{{ section.settings.heading }}</h2>
  <div class="usp-container">
    {% for block in section.blocks %}
      <div class="usp">
        <span class="usp-icon">
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | image_url }}" alt="USP Icon">
          {% endif %}
        </span>
        <div class="usp-content">
          <h3 class="usp-title">{{ block.settings.title }}</h3>
          <p class="usp-desc">{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "USP Section",
  "tag": "section",
  "class": "usp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Promise"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Skin-Friendly"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Hypoallergenic Jewellery crafted for Comfort"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "USP Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
