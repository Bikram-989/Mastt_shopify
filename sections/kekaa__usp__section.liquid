{%- comment -%}
  Our Promise — trust cards with a square photo well.

  Each card carries a square frame that holds a real photograph, not just a
  line icon. Upload anything — product macro, hand shot, packaging — square,
  and it fills the frame edge to edge with nothing cropped.

  Same block settings as before (icon / title / description), so existing
  content carries over untouched.
{%- endcomment -%}

<style>
  #Usp-{{ section.id }} h2,
  #Usp-{{ section.id }} h3,
  #Usp-{{ section.id }} p { margin: 0; }

  #Usp-{{ section.id }} {
    position: relative;
    isolation: isolate;
    padding-block: clamp(28px, 20px + 2vw, 72px);
  }

  #Usp-{{ section.id }} .kk__heading {
    text-align: center;
    /* Extra room below: the first card's photo well straddles its top edge. */
    margin-bottom: clamp(44px, 34px + 2.4vw, 64px) !important;
  }

  /* Tinted ground so the cards read as one set. */
  #Usp-{{ section.id }} .usp-panel {
    position: relative;
    border-radius: var(--radius-lg, 24px);
    padding: clamp(22px, 16px + 1.6vw, 36px) clamp(12px, 6px + 1.6vw, 32px)
             clamp(20px, 14px + 1.6vw, 40px);
    background:
      linear-gradient(160deg,
        color-mix(in srgb, var(--color-blush-pink) 30%, var(--color-pearl-beige)) 0%,
        color-mix(in srgb, var(--color-nude-beige) 55%, var(--color-pearl-beige)) 55%,
        color-mix(in srgb, var(--color-aqua) 20%, var(--color-pearl-beige)) 100%);
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 7%, transparent);
  }

  #Usp-{{ section.id }} .usp-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(34px, 24px + 2.4vw, 44px) clamp(10px, 6px + 1.2vw, 24px);
    max-width: 1120px;
    margin: 0 auto;
  }

  @media screen and (min-width: 990px) {
    #Usp-{{ section.id }} .usp-container {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, minmax(0, 1fr));
    }
  }

  /* Card: flat-bottomed with a softly rounded top. */
  #Usp-{{ section.id }} .usp {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    padding: clamp(34px, 26px + 2vw, 48px) clamp(10px, 6px + 1vw, 20px)
             clamp(16px, 12px + 1vw, 26px);
    background: color-mix(in srgb, var(--color-white) 62%, transparent);
    border-radius: clamp(28px, 20px + 2vw, 44px) clamp(28px, 20px + 2vw, 44px)
                   var(--radius-md, 16px) var(--radius-md, 16px);
    box-shadow: var(--shadow-sm);
  }

  /* Square photo well, straddling the card's top edge. Was a diamond; a
     rotated frame always clips an image's corners, and no amount of scaling
     avoids that. A square shows the whole photograph. */
  #Usp-{{ section.id }} .usp-icon {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(60px, 48px + 3.4vw, 88px);
    aspect-ratio: 1;
    transform: translate(-50%, -46%);
    border-radius: var(--radius-sm, 10px);
    overflow: hidden;
    background: var(--color-white, #fff);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-charcoal) 8%, transparent),
                var(--shadow-md);
    display: grid;
    place-items: center;
    transition: transform 380ms var(--ease-out, ease);
  }

  @media (hover: hover) {
    #Usp-{{ section.id }} .usp:hover .usp-icon {
      transform: translate(-50%, -52%);
    }
  }

  /* Square frame, square image — fills edge to edge, nothing cropped away. */
  #Usp-{{ section.id }} .usp-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #Usp-{{ section.id }} .usp-icon .usp-icon__empty {
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg,
      var(--color-pearl-beige) 0%, var(--color-nude-beige) 100%);
  }

  #Usp-{{ section.id }} .usp-title {
    font-family: var(--font-heading-family);
    font-size: clamp(14px, 12px + 0.6vw, 19px);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-charcoal, #201B19);
    text-wrap: balance;
  }

  #Usp-{{ section.id }} .usp-desc {
    font-family: var(--font-body-family);
    font-size: clamp(11px, 10px + 0.35vw, 14px);
    line-height: 1.45;
    color: var(--color-charcoal-70, #6B5F5B);
    max-width: 22ch;
    text-wrap: pretty;
  }
</style>

<section id="Usp-{{ section.id }}" class="usp-wrapper kk__wrapper page-width">
  {%- comment -%}
    Heading sits inside the panel, so the gradient carries the whole section
    rather than a heading floating above a tinted box.
  {%- endcomment -%}
  <div class="usp-panel">
    {%- if section.settings.heading != blank -%}
      <h2 class="kk__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="usp-container">
      {%- for block in section.blocks -%}
        <div class="usp" {{ block.shopify_attributes }}>
          <span class="usp-icon">
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 320 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="160"
                height="160"
              >
            {%- else -%}
              <span class="usp-icon__empty" aria-hidden="true"></span>
            {%- endif -%}
          </span>

          <h3 class="usp-title">{{ block.settings.title }}</h3>
          <p class="usp-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "USP Section",
  "tag": "section",
  "class": "usp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Promise"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Photo or icon",
          "info": "Fills the square frame. Upload square — 320 x 320 or larger. Photographs work as well as line icons."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Skin-Friendly"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Hypoallergenic Jewellery crafted for Comfort"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "USP Section",
      "blocks": [
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" }
      ]
    }
  ]
}
{% endschema %}
