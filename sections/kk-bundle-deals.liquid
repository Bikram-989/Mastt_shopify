      const itemRoom  = Math.max(0, limit - cur);

      if (itemRoom <= 0) { toast(`Max ${limit} per item allowed for this step.`); return; }
      inc = Math.min(1, stepRoom, totalRoom, itemRoom);
      if (inc <= 0) { toast('Step full or limit reached.'); return; }
    } else if (delta < 0 && cur <= 1) {
      const ok=await __removeVariantEverywhere(vid); if(!ok){ toast('Couldn’t update cart.'); return; }
      applyRemove(vid,1); renderDrawer(); enforceAllLocks(); findCardsByVariantId(vid).forEach(c=>{ normalizeCardButton(c); renderQtyWidgetForCard(c,vid); }); __dealsScheduleSync(160); return;
    } else inc=-1;

    if (inc>0) applyAdd(vid,inc); else applyRemove(vid,-inc);
    updateUnlocked(); renderDrawer(); enforceAllLocks(); findCardsByVariantId(vid).forEach(c=>{ normalizeCardButton(c); renderQtyWidgetForCard(c,vid); });

    __markInflight(inflightAdd,vid); __markInflight(inflightUpdate,vid);
    try{
      __lockSync(1200);
      const nextQty=(added[vid]?.qty||0);
      const payload={ updates:{[vid]:nextQty}, sections:__DEALS_SECTIONS.join(','), sections_url:(location.pathname||'/')+(location.search||'') };
      const res=await fetch('/cart/update.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify(payload)});
      if(!res.ok) throw 0;
      let state=null; try{ state=await res.json(); }catch(_){}
      if(state?.sections) __patchCartSections(state.sections); else __dealsScheduleSync(200);
      __persistDealsState(); document.dispatchEvent(new CustomEvent('cart:change',{bubbles:true})); __runAfterUnlock(()=>__dealsScheduleSync(200));
    }catch(_){
      if (inc>0) applyRemove(vid,inc); else applyAdd(vid,-inc);
      updateUnlocked(); renderDrawer(); enforceAllLocks(); findCardsByVariantId(vid).forEach(c=>{ normalizeCardButton(c); renderQtyWidgetForCard(c,vid); });
      toast('Couldn’t update cart.');
    }finally{ inflightAdd.delete(vid); inflightUpdate.delete(vid); }
  }

  const renderSummary = () => {
    const frag = document.createDocumentFragment(); let sale = 0, mrp = 0;
    Object.entries(added).forEach(([vid, info]) => {
      if (!info.qty) return;
      const lineS = info.priceC * info.qty,
            lineM = Math.max(info.compareC, info.priceC) * info.qty;
      sale += lineS; mrp += lineM;

      const row = document.createElement('div');
      row.className = 'row';
      row.innerHTML = `
        <div class="meta">
          <img src="${info.img}" alt="${info.title}">
          <div class="meta-text">
            <div class="line-title" title="${info.title}">${info.title}</div>
            <div class="price">
              ${fmtMoney(lineS)}${info.compareC>info.priceC?` <s>${fmtMoney(lineM)}</s>`:''}
              <span class="qty-badge">×${info.qty}</span>
            </div>
          </div>
        </div>
        <div class="actions">
          <button class="summary-remove" data-vid="${vid}" aria-label="Remove ${info.title}" title="Remove">
            <svg class="icon-bin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m5 0V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"></path>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
          </button>
        </div>`;
      frag.appendChild(row);
    });
    sumItems.innerHTML = '';
    sumItems.appendChild(frag);

    const mrpDisc   = Math.max(0, mrp - sale);
    const totalCount = getTotalCount();
    const effPriceC  = effectiveDealPriceCents(totalCount);

    let final   = sale;
    let dealDisc = 0;
    if (effPriceC > 0 && sale > 0) {
      final    = Math.min(effPriceC, sale);
      dealDisc = Math.max(0, sale - final);
    }

    const set = (els, vals) => els.forEach((el, i) => { if (el) el.textContent = vals[i]; });
    if (sale > 0) {
      const vals = [
        fmtMoney(mrp),
        fmtMoney(sale),
        mrpDisc > 0 ? `- ${fmtMoney(mrpDisc)}` : '—',
        dealDisc > 0 ? `- ${fmtMoney(dealDisc)}` : '—',
        fmtMoney(final)
      ];
      set([mrpSubEl,  saleSubEl,  mrpDiscEl,  dealDiscEl,  totalEl],  vals);
      set([mrpSubElF, saleSubElF, mrpDiscElF, dealDiscElF, totalElF], vals);
      if (totalMobile) totalMobile.textContent = fmtMoney(final);
      const totalSave = mrpDisc + dealDisc;
      if (totalSave > 0) { savingsEl.textContent = `You save ${fmtMoney(totalSave)}`; savingsEl.classList.remove('hidden'); }
      else { savingsEl.classList.add('hidden'); }
      bundleNote.hidden = !(effPriceC > 0);
    } else {
      const d = ['—','—','—','—','—'];
      set([mrpSubEl,  saleSubEl,  mrpDiscEl,  dealDiscEl,  totalEl],  d);
      set([mrpSubElF, saleSubElF, mrpDiscElF, dealDiscElF, totalElF], d);
      if (totalMobile) totalMobile.textContent = '—';
      savingsEl.classList.add('hidden');
      bundleNote.hidden = true;
    }

    // CAP visible items (unchanged)
    (function capSummaryList(){
      const rows = sumItems.querySelectorAll('.row');
      if (!rows.length) {
        sumItems.classList.remove('is-capped');
        sumItems.style.removeProperty('--summary-max-h');
        return;
      }
      const visible = Math.min(4, rows.length);
      const firstRowRect = rows[0].getBoundingClientRect();
      const rowH = Math.max(1, firstRowRect.height || 0);
      const cs = getComputedStyle(sumItems);
      const rowGap = parseFloat(cs.rowGap || '8') || 8;

      const maxH = Math.round(rowH * visible + rowGap * (visible - 1));
      if (rows.length > 4) {
        sumItems.style.setProperty('--summary-max-h', `${maxH}px`);
        sumItems.classList.add('is-capped');
      } else {
        sumItems.classList.remove('is-capped');
        sumItems.style.removeProperty('--summary-max-h');
      }
    })();

    if (drawer.classList.contains('deal-drawer--fullscreen')) syncFullscreenMetrics();
  };



  const renderDrawer=()=>{
    itemsEl.innerHTML=''; const frag=document.createDocumentFragment();
    Object.entries(added).forEach(([vid,info])=>{ const el=document.createElement('div'); el.className='drawer-item'; el.dataset.vid=vid; el.innerHTML=`<img src="${info.img}" alt="${info.title}"><span class="chip-qty">×${info.qty}</span><button class="drawer-remove" title="Remove">×</button>`; frag.appendChild(el); });
    itemsEl.appendChild(frag); itemsEl.classList.toggle('hidden', isReview());

    const total=getTotalCount();

    // === NEW: Active checkpoint badge/progress ===
    const target = currentDealTarget(total);
    badge.textContent = `${Math.min(total, target)}/${target}`;
    const pct= target>0 ? Math.min(100, Math.round((Math.min(total,target)/target)*100)) : 0;
    setProgressAnimated(pct);
    progBar.setAttribute('role','progressbar');
    progBar.setAttribute('aria-valuemin','0');
    progBar.setAttribute('aria-valuemax', String(target));
    progBar.setAttribute('aria-valuenow', String(Math.min(total,target)));
    progBar.setAttribute('aria-valuetext', `${Math.min(total,target)} of ${target} added`);

    drawer.classList.toggle('deal-drawer--is-review', isReview());

    // Header message (nudge through tiers)
    drawerMsgEl.textContent = dealNudgeMessage(total);
    drawerMsgEl.style.display = '';

    const bundlePriceExists = Math.round((parseFloat('{{ section.settings.bundle_price }}')||0)*100) > 0;

    // Toggle button behavior remains unchanged except for compact/expanded logic
    const toggleBtn = document.getElementById('drawer-toggle-{{ section.id }}');

    if (!isReview()){
      const need = stepRequired[Number(currentStep)] || 0,
            have = stepCounts[Number(currentStep)] || 0;
      proceedBtn.disabled = have < need;
      proceedBtn.textContent = (Number(currentStep) === stepsCount - 1) ? 'Review' : 'Next step';
      mobileCta?.classList.add('hidden');
      summaryFooter?.classList.add('hidden');
      drawerProgress.style.display = '';
      if (toggleBtn) {
        const showToggle = isMobile();
        toggleBtn.style.display = showToggle ? '' : 'none';
        toggleBtn.disabled = !showToggle;
        toggleBtn.setAttribute('aria-expanded', drawer.classList.contains('deal-drawer--compact') ? 'false' : 'true');
        toggleBtn.title = drawer.classList.contains('deal-drawer--compact') ? 'Expand' : 'Collapse';
      }
    } else {
      // Review: Shiprocket lock depends on step completion (unchanged gating)
      const canCk = total >= totalRequired;
      srWrapBill?.classList.toggle('is-locked', !canCk);
      summaryWrap.classList.remove('hidden');

      const inFull = isMobile() && drawer.classList.contains('deal-drawer--fullscreen');
      summaryFooter?.classList.toggle('hidden', !inFull);
      srWrapFooter?.classList.toggle('is-locked', !canCk);

      if (mobileCta) {
        mobileCta.classList.toggle('hidden', !isMobile());
        srWrapMobile?.classList.toggle('is-locked', !canCk);
      }
      drawerProgress.style.display = 'none';
      if (toggleBtn) { toggleBtn.setAttribute('aria-expanded','true'); toggleBtn.style.display='none'; toggleBtn.disabled = true; }
      renderSummary();
    }

    const canReview = total >= totalRequired;
    stepperTop.querySelectorAll('.deal-step-indicator').forEach(li => {
      const k = li.dataset.stepIndex, isRev = k === 'review';
      li.classList.toggle('active', isRev ? isReview() : String(Number(currentStep)) === k);
      if (isRev) li.classList.toggle('locked', !canReview);
      else {
        const n = parseInt(k || '-1', 10);
        li.classList.toggle('locked', n > maxUnlockedStep);
      }
    });

    setHelperText(getHelpFor(isReview()?'review':currentStep));
    updateStepPillBadges();
    __persistDealsState();
  };

  const normalizeCardButton = (card) => {
    const form = card.querySelector('product-form form, form[action^="/cart/add"]');
    const btn  = card.querySelector('.quick-add__submit');
    if (!form || !btn) return;

    const firstId = card.dataset.firstInstockId;
    const idInput = form.querySelector('input[name="id"]');
    if (firstId && idInput) idInput.value = firstId;

    if (!btn.dataset.dealsBaseLabel) {
      const base = baseAddLabel(btn);
      btn.dataset.dealsBaseLabel = base;
      btn.dataset.originalLabel  = base;
    }

    const vid    = idInput?.value;
    const isAdded = !!(vid && added[vid]?.qty);
    const grid   = card.closest('.step-grid');
    const stepFull = grid?.getAttribute('data-step-full') === '1';
    if (stepFull) {
      setBtnFrozen(btn, true);
    } else {
      setBtnFrozen(btn, false);
    }

    const stepIdx = isAdded ? added[vid].step : parseInt(card.dataset.stepIndex || '0', 10) || 0;
    setCardQtyMode(card, stepIdx);

    if (isAdded) {
      card.classList.add('is-added');

      if (card.hasAttribute('data-has-qty')) {
        setBtnFrozen(btn, false);
        if (vid) renderQtyWidgetForCard(card, String(vid));
      } else {
        card.querySelector('.deal-qty')?.remove();
        __setBtnText(btn, 'Added to deal');
        setBtnFrozen(btn, false);
      }
    } else {
      card.classList.remove('is-added');
      card.querySelector('.deal-qty')?.remove();
      setBtnFrozen(btn, !!stepFull);
      __setBtnText(btn, btn.dataset.dealsBaseLabel || SAFE_ADD_LABEL);
    }
  };

  const normalizeGrid=(grid)=> grid?.querySelectorAll('.deal-card').forEach(normalizeCardButton);
  const enforceAllLocks=()=>{ grids.forEach((g,i)=>{ const full=(stepCounts[i]||0)>=(stepRequired[i]||0); if(g) g.setAttribute('data-step-full', full?'1':'0'); g?.querySelectorAll('.quick-add__submit').forEach(btn=>setBtnFrozen(btn, full)); }); };

  const syncFullscreenMetrics=()=>{ /* unchanged */ 
    if (!drawer.classList.contains('deal-drawer--fullscreen')) return;
    const headerH = drawerHeader ? drawerHeader.getBoundingClientRect().height : 56;
    const footerH = summaryFooter && !summaryFooter.classList.contains('hidden') ? summaryFooter.getBoundingClientRect().height : 96;
    drawer.style.setProperty('--topbar-h', `${Math.round(headerH)}px`);
    drawer.style.setProperty('--cta-h', `${Math.round(footerH)}px`);
  };
  const enterFullscreenReview=()=>{ if(!isMobile()) return; drawer.classList.add('deal-drawer--fullscreen'); document.documentElement.style.overflow='hidden'; document.body.style.overflow='hidden'; summaryFooter?.classList.remove('hidden'); document.documentElement.style.scrollPaddingBottom='0px'; document.body.style.marginBottom='0px'; syncFullscreenMetrics(); scrollToTopOfSection(); };
  const exitFullscreenReview=()=>{ drawer.classList.remove('deal-drawer--fullscreen'); summaryFooter?.classList.add('hidden'); document.documentElement.style.overflow=''; document.body.style.overflow=''; };

  let __stepSwapRAF;
  const goToStep=(idx)=>{
    if (__stepSwapRAF) cancelAnimationFrame(__stepSwapRAF);
    __stepSwapRAF = requestAnimationFrame(()=>{
      __quiet(1200);
      currentStep = idx;
      const atReview = isReview();
      setHelperText(getHelpFor(atReview?'review':idx));
      grids.forEach((g,i)=> g.classList.toggle('hidden', atReview ? (i!==stepsCount-1) : (i!==Number(idx))));
      if(!atReview){ summaryWrap.classList.add('hidden'); actionsBar.style.display='flex'; prevBtn.classList.toggle('hidden', Number(currentStep)===0); exitFullscreenReview(); mobileCta?.classList.add('hidden'); }
      else { summaryWrap.classList.remove('hidden'); actionsBar.style.display='none'; if (isMobile()) enterFullscreenReview(); __ensureShiprocketReadySoon(); }
      enforceAllLocks(); normalizeGrid(grids[Number(atReview?stepsCount-1:idx)]); renderDrawer(); updateStepPillBadges();
      stepperTop.querySelectorAll('.deal-step-indicator').forEach(li=>{ const k=li.dataset.stepIndex; const sel=(atReview&&k==='review') || (!atReview && Number(k)===Number(currentStep)); li.setAttribute('aria-selected', sel?'true':'false'); li.tabIndex=sel?0:-1; });
      scrollToTopOfSection();
    });
  };

  /* ====== A11y + Nav ====== */
  stepperTop.addEventListener('click', (e)=>{ const li=e.target.closest('.deal-step-indicator'); if(!li || li.classList.contains('locked')) return; const raw=li.dataset.stepIndex; if(raw==='review') goToStep(REVIEW); else { const i=parseInt(raw||'-1',10); if(Number.isInteger(i)) goToStep(i);} });
  stepperTop.addEventListener('keydown', (e)=>{ const keys=['ArrowRight','ArrowLeft','Home','End','Enter',' ']; if(!keys.includes(e.key)) return; e.preventDefault();
    const pills=[...stepperTop.querySelectorAll('.deal-step-indicator:not(.locked)')]; const cur=pills.findIndex(p=>p.getAttribute('aria-selected')==='true');
    if(e.key==='Home'){ pills[0]?.click(); pills[0]?.focus(); return; }
    if(e.key==='End'){ pills[pills.length-1]?.click(); pills[pills.length-1]?.focus(); return; }
    if(e.key==='Enter'||e.key===' '){ document.activeElement?.click(); return; }
    const dir=e.key==='ArrowRight'?1:-1, next=Math.max(0,Math.min(pills.length-1,cur+dir)); pills[next]?.focus(); pills[next]?.click();
  });

  prevBtn.addEventListener('click',(e)=>{ e.preventDefault(); if(isReview()) goToStep(stepsCount-1); else if(Number(currentStep)>0) goToStep(Number(currentStep)-1); });
  document.getElementById('summary-back-{{ section.id }}')?.addEventListener('click', e=>{ e.preventDefault(); goToStep(stepsCount-1); });
  backMobile?.addEventListener('click', e=>{ e.preventDefault(); goToStep(stepsCount-1); });
  backFooterBtn?.addEventListener('click', e=>{ e.preventDefault(); goToStep(stepsCount-1); });

  proceedBtn.addEventListener('click', ()=>{ if(isReview()) return; __quiet(1200); const cur=Number(currentStep)||0; if(cur<(stepsCount-1)) goToStep(cur+1); else goToStep(REVIEW); });

  const renderStartGrid=()=>{ grids.forEach((g,i)=> g.classList.toggle('hidden', i!==0)); drawerDims(); updateUnlocked();
    try{ const m=badge?.textContent?.match(/(\d+)\s*\/\s*(\d+)/), cur=m?parseInt(m[1]||'0',10):0, req=m?parseInt(m[2]||'0',10):0; __dealPrevPct = req>0 ? Math.min(100, Math.round((cur/req)*100)) : 0; }catch(_){}
    renderDrawer(); enforceAllLocks(); grids.forEach(normalizeGrid);
  };

  /* ====== Add / Remove / Qty ====== */
  section.addEventListener('change', (e)=>{ const card=e.target.closest('.deal-card'); if(!card) return; normalizeCardButton(card); enforceAllLocks(); });

  section.addEventListener('submit', (e)=>{ const form=e.target.closest('product-form form, form[action^="/cart/add"]'); if(!form) return; e.preventDefault(); e.stopImmediatePropagation(); dealsQuickAddFromForm(form); }, true);

  async function dealsQuickAddFromForm(form){
    const card = form.closest('.deal-card'),
          btn  = card?.querySelector('.quick-add__submit');

    const idInput = form.querySelector('input[name="id"]');
    if (card?.dataset.firstInstockId && idInput) idInput.value = card.dataset.firstInstockId;

    const stepIdx = parseInt(card?.dataset.stepIndex || '0', 10) || 0;
    if (!canAddToStep(stepIdx, 1)) {
      toast(`Step full. Needed ${stepRequired[stepIdx] || 0}, selected ${stepCounts[stepIdx] || 0}.`);
      enforceAllLocks();
      return;
    }

    const vid = idInput?.value;
    if (!vid) return;

    if (added[vid]?.step === stepIdx && (added[vid]?.qty || 0) > 0) {
      await changeVariantQty(vid, +1);
      return;
    }

    const limit    = perItemLimit(stepIdx);
    const existing = (added[vid]?.step === stepIdx) ? (added[vid]?.qty || 0) : 0;
    if (existing >= limit) { toast(`Max ${limit} per item allowed for this step.`); return; }

    const title   = card.querySelector('.card__heading a')?.textContent?.trim() || '';
    const imgEl   = card.querySelector('.card__media img, img');
    const img     = imgEl ? (imgEl.currentSrc || imgEl.src || '') : '';
    const priceC  = parseInt(card?.dataset.firstPriceCents || '0', 10) || 0;
    const compareC= parseInt(card?.dataset.firstCompareCents || String(priceC), 10) || priceC;

    ensureAdded(vid, stepIdx, { title, img, priceC, compareC });
    applyAdd(vid, 1);

    if (card) {
      card.classList.add('is-added');
      setCardQtyMode(card, stepIdx);
      if (card.hasAttribute('data-has-qty')) {
        renderQtyWidgetForCard(card, String(vid));
      } else {
        card.querySelector('.deal-qty')?.remove();
        const addBtn = btn || card.querySelector('.quick-add__submit');
        if (addBtn) {
          __setBtnText(addBtn, 'Added to deal');
          setBtnFrozen(addBtn, false);
        }
      }
    }

    __markInflight(inflightAdd, vid);
    maybeFlyToDrawer(imgEl);
    updateUnlocked();
    renderDrawer();
    setHelperText(getHelpFor(isReview() ? 'review' : currentStep));
    updateStepPillBadges();
    if (card) normalizeCardButton(card);

    const fd = new FormData(form);
    fd.set('id', vid);
    if (!fd.get('quantity')) fd.set('quantity', '1');
    fd.set('sections', __DEALS_SECTIONS.join(','));
    fd.set('sections_url', (location.pathname || '/') + (location.search || ''));

    const toDisable = [btn].filter(Boolean);
    toDisable.forEach(b => { if (b) { b.dataset.prevDisabled = b.disabled ? '1' : '0'; b.disabled = true; } });

    try {
      __lockSync(900);
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json' },
        body: fd
      });
      if (!res.ok) {
        let message = 'Could not add to cart.';
        try { const j = await res.json(); if (j?.description) message = j.description; } catch(_) {}
        throw new Error(message);
      }

      try {
        const state = await res.json();
        if (state?.sections) __patchCartSections(state.sections);
      } catch(_) {
        __dealsScheduleSync(220);
      }

      const need = stepRequired[stepIdx] || 0, have = stepCounts[stepIdx] || 0;
      enforceAllLocks();
      if (AUTO_ADVANCE && have >= need) {
        let next = null;
        for (let i = 0; i < stepsCount; i++) { if (stepCounts[i] < stepRequired[i]) { next = i; break; } }
        __quiet(1200);
        setTimeout(() => next !== null && next > stepIdx ? goToStep(next) : goToStep(REVIEW), 120);
      }

      __persistDealsState();
      document.dispatchEvent(new CustomEvent('cart:change', { bubbles: true }));
      __runAfterUnlock(() => __dealsScheduleSync(240));
    } catch (err) {
      applyRemove(vid, 1);
      inflightAdd.delete(String(vid));
      updateUnlocked();
      renderDrawer();
      setHelperText(getHelpFor(isReview() ? 'review' : currentStep));
      updateStepPillBadges();

      if (card) {
        card.classList.remove('is-added');
        card.querySelector('.deal-qty')?.remove();
        normalizeCardButton(card);
      }

      const errWrap = section.querySelector('.product-form__error-message-wrapper');
      if (errWrap) {
        errWrap.hidden = false;
        const span = errWrap.querySelector('.product-form__error-message');
        if (span) span.textContent = err?.message || 'Could not add to cart.';
      } else {
        toast(err?.message || 'Could not add to cart.');
      }
    } finally {
      toDisable.forEach(b => {
        if (!b) return;
        const prev = b.dataset.prevDisabled === '1';
        b.disabled = prev;
        delete b.dataset.prevDisabled;
      });
    }
  }

  async function __removeVariantEverywhere(variantId){
    const vid=String(variantId);
    try{ const r=await fetch('/cart/update.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({updates:{[vid]:0}})}); if(r.ok) return true; }catch(_){}
    try{
      const cart=await fetch('/cart.js',{credentials:'same-origin',headers:{'Accept':'application/json'}}).then(r=>r.json());
      const keys=(cart.items||[]).filter(it=>String(it.variant_id)===vid).map(it=>it.key);
      if(!keys.length) return true;
      await Promise.all(keys.map(key=> fetch('/cart/change.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify({id:key, quantity:0})})));
      return true;
    }catch(_){ }
    return false;
  }

  section.addEventListener('click', async (e)=>{
    const chip=e.target.closest('.drawer-item .drawer-remove'); const sum=e.target.closest('.summary-remove'); if(!chip && !sum) return;
    const row = chip ? chip.closest('.drawer-item') : sum.closest('.actions')?.closest('.row'); const vid = chip ? row?.dataset.vid : sum?.dataset.vid; if(!vid) return;
    const info=added[vid], takeAll=info?.qty||0; if(takeAll<=0) return;
    removeAllOfVariant(vid); renderDrawer(); enforceAllLocks(); findCardsByVariantId(vid).forEach(normalizeCardButton);
    try{
      __lockSync(800);
      const payload={ id:vid, quantity:0, sections:__DEALS_SECTIONS.join(','), sections_url:(location.pathname||'/')+(location.search||'') };
      const res=await fetch('/cart/change.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify(payload)});
      if(!res.ok) throw 0;
      let state=null; try{ state=await res.json(); }catch(_){}
      state?.sections ? __patchCartSections(state.sections) : __dealsScheduleSync(200);
      document.dispatchEvent(new CustomEvent('cart:change',{bubbles:true}));
      __runAfterUnlock(()=>__dealsScheduleSync(200));
    }catch(_){
      ensureAdded(vid, info.step, info); applyAdd(vid, takeAll); renderDrawer(); enforceAllLocks(); findCardsByVariantId(vid).forEach(normalizeCardButton); toast('Couldn’t remove item.');
    }
  });

  window.addEventListener('resize', ()=>{ if (isReview()){ if(isMobile()) enterFullscreenReview(); else exitFullscreenReview(); mobileCta?.classList.toggle('hidden', !isMobile()); syncFullscreenMetrics(); summaryFooter?.classList.toggle('hidden', !(isReview()&&isMobile()&&drawer.classList.contains('deal-drawer--fullscreen'))); } else exitFullscreenReview(); drawerDims(); });
  window.addEventListener('orientationchange', ()=> setTimeout(syncFullscreenMetrics,250));

  section.addEventListener('click', async (e)=>{
    const btn=e.target.closest('.deal-qty__btn'); if(!btn) return;
    const vid=btn.getAttribute('data-vid'); const delta=btn.getAttribute('data-delta')==='+1'?+1:-1;
    const cards=findCardsByVariantId(vid); cards.forEach(c=> c.querySelector('.deal-qty')?.setAttribute('aria-disabled','true'));
    await changeVariantQty(vid, delta);
    cards.forEach(c=> c.querySelector('.deal-qty')?.removeAttribute('aria-disabled'));
  });

  // Block quick-add clicks when the step is full
  section.addEventListener('click', (e) => {
    const btn = e.target.closest('.quick-add__submit');
    if (!btn) return;
    const grid = btn.closest('.step-grid');
    if (grid && grid.getAttribute('data-step-full') === '1') {
      e.stopImmediatePropagation();
      e.preventDefault();
      toast('Step full. Remove an item to add another.');
    }
  }, true);

  /* Drawer position + observers */
  const ro=new ResizeObserver(()=>{ drawerDims(); syncFullscreenMetrics(); }); ro.observe(section);

  document.addEventListener('visibilitychange', ()=>{ if(!document.hidden){ enforceAllLocks(); grids.forEach(normalizeGrid); setHelperText(getHelpFor(isReview()?'review':currentStep)); updateStepPillBadges(); } });

  (function __bridgeCartDrawerToDeals(){
    const d=document.querySelector('cart-drawer'); if(!d) return;
    const getVid=(row)=>{ if(!row) return null;
      const attr=row.getAttribute('data-variant-id')||row.dataset?.variantId; if(attr) return String(attr);
      const key=row.querySelector('input[name="id"], input[name="updates[]"][data-variant-id]'); if(key?.dataset?.variantId) return String(key.dataset.variantId);
      if(key?.value && /^\d+$/.test(key.value)) return String(key.value);
      const alt=row.querySelector('[data-variant-id], [data-variant_id]'); if(alt) return String(alt.getAttribute('data-variant-id')||alt.getAttribute('data-variant_id'));
      return null;
    };
    d.addEventListener('click',(e)=>{
      const row=e.target.closest?.('[data-cart-item], .cart-item, li, tr'); if(!row) return;
      const isRemove= e.target.closest?.('[name="remove"], button[name="remove"], .cart-remove-button') || e.target.matches?.('[name="remove"], button[name="remove"]');
      const isMinus= e.target.closest?.('[data-quantity-decrement], .quantity__button--minus, [aria-label="Decrease quantity"]');
      const isPlus = e.target.closest?.('[data-quantity-increment], .quantity__button--plus,  [aria-label="Increase quantity"]');
      if(!isRemove && !isMinus && !isPlus) return;
      const vid=getVid(row); if(!vid){ __dealsScheduleSync(120); return; }
      const info=added[vid];
      if(info){
        if (isRemove) removeAllOfVariant(vid);
        else if (isMinus) applyRemove(vid,1);
        else { const i=info.step, roomT=Math.max(0,totalRequired-getTotalCount()); const roomS=Math.max(0,(stepRequired[i]||0)-(stepCounts[i]||0)); if(roomT>0 && roomS>0) applyAdd(vid,1); }
        renderDrawer(); enforceAllLocks(); findCardsByVariantId(vid).forEach(normalizeCardButton);
      }
      setTimeout(()=>__dealsScheduleSync(160),0);
    }, true);
    d.addEventListener('change',(e)=>{ const input=e.target.closest?.('input[type="number"][name^="updates"]'); if(!input) return; setTimeout(()=>__dealsScheduleSync(120),0); }, true);
  })();

  (function __patchFetchUnified(){
    if(!window.fetch || window.__dealsFetchPatchedUnifiedV3) return;
    const orig=window.fetch;
    window.fetch = async function(input, init){
      const url = (typeof input==='string')?input: (input&&input.url)||'';
      const method=((init&&init.method)||'GET').toUpperCase();
      const touches = /\/cart\/(?:add|change|update)\.js(\?|$)|\/cart\.js(\?|$)/.test(url) || (url.endsWith('/cart.js') && method!=='GET');
      const res = await orig.apply(this, arguments); if(touches) __runAfterUnlock(()=>__dealsScheduleSync(220)); return res;
    };
    window.__dealsFetchPatchedUnifiedV3 = true;
  })();


  /* ====== Startup ====== */
  renderStartGrid();

  drawer.classList.add('deal-drawer--compact');

  (async function __startupRestore(){
    const idx=__buildVariantMetaIndex(); const cached=__loadPersistedDealsState();
    if(cached?.added){ added={}; stepCounts=stepRequired.map(()=>0);
      Object.entries(cached.added).forEach(([vid,o])=>{ const meta=idx[vid]; if(!meta) return; ensureAdded(vid, meta.step, meta);
        const want=parseInt(o.qty,10)||0, roomT=Math.max(0,totalRequired-stepCounts.reduce((a,b)=>a+b,0)), roomS=Math.max(0,(stepRequired[meta.step]||0)-stepCounts[meta.step]), take=Math.max(0, Math.min(want, roomT, roomS));
        if(take>0){ added[vid].qty=take; stepCounts[meta.step]+=take; }
      });
      updateUnlocked(); renderDrawer(); enforceAllLocks(); grids.forEach(normalizeGrid); setHelperText(getHelpFor(isReview()?'review':currentStep)); updateStepPillBadges();
    }
    await __restoreFromCart();
    __ensureShiprocketReadySoon();
  })();

  window.addEventListener('pageshow', (e)=>{ if(e.persisted) __restoreFromCart(); });

  ['cart:update','cart:refresh','cart:change','cart:updated','cart-remove','cart:item-removed','cart-drawer:render','cart-notification:show']
    .forEach(evt => { document.addEventListener(evt, ()=>__dealsScheduleSync(100), true); window.addEventListener(evt, ()=>__dealsScheduleSync(100), true); });

  /* ===== Compact Drawer Controller (mobile; compact by default) ===== */
  (function compactDrawerController(){
    const isMob = () => window.matchMedia('(max-width: 989px)').matches;
    const inReview = () => isReview();
    const toggleBtn = document.getElementById('drawer-toggle-{{ section.id }}');

    function setDrawerMode(mode){
      const compact = (mode === 'compact');
      drawer.classList.toggle('deal-drawer--compact', compact);
      if (toggleBtn){
        toggleBtn.setAttribute('aria-expanded', compact ? 'false' : 'true');
        toggleBtn.title = compact ? 'Expand' : 'Collapse';
      }
    }

    function applyDesiredMode(){
      if (!isMob()) { setDrawerMode('expanded'); return; }
      if (inReview()) { setDrawerMode('expanded'); return; }
      setDrawerMode('compact');
    }

    if (toggleBtn){
      toggleBtn.addEventListener('click', (e)=> {
        if (isReview()) { e.preventDefault(); return; }
        e.preventDefault();
        const compact = drawer.classList.contains('deal-drawer--compact');
        drawer.classList.toggle('deal-drawer--compact', !compact);
        toggleBtn.setAttribute('aria-expanded', compact ? 'true' : 'false');
        toggleBtn.title = compact ? 'Collapse' : 'Expand';
        try { scrollToTopOfSection(); } catch(_){}
      });
    }

    drawer.querySelector('.drawer-header')?.addEventListener('click', (e)=>{
      if (e.target.closest('#drawer-actions-{{ section.id }}')) return;
      if (e.target.closest('.drawer-toggle')) return;
      const compact = drawer.classList.contains('deal-drawer--compact');
      setDrawerMode(compact ? 'expanded' : 'compact');
    }, true);

    const __origGoToStep = goToStep;
    goToStep = function(idx){
      __origGoToStep(idx);
      applyDesiredMode();
    };

    window.addEventListener('resize', applyDesiredMode);
    window.addEventListener('orientationchange', () => setTimeout(applyDesiredMode, 250));
    document.addEventListener('visibilitychange', () => { if (!document.hidden) applyDesiredMode(); });

    applyDesiredMode();
  })();

}); // DOMContentLoaded
</script>