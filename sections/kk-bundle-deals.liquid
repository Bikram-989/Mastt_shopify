{%- comment -%}
/*
  sections/deals-drawer.liquid — lean build (UI v3 + fixes + real add-to-cart)

  This version:
  • EARLY capture-phase blockers to suppress Dawn cart drawer/notification before they bind
  • Global submit/click guards to keep add-to-cart under our control
  • Variant pick uses v.available (not inventory_quantity) so untracked/continue policy works
  • Quick Add: intercepts form "submit" -> POST /cart/add.js (no Dawn UI, no redirect)
  • Review keeps last step’s grid visible; chips hidden on Review
  • Progress bar fills correctly; header message reflects unlock
  • Review step: Shiprocket Headless (cart) replaces Checkout; single action row (Back + Shiprocket)
  • All-steps locking after add/remove; force-enables buttons when a step is NOT full
  • After removing via chips/summary, card buttons re-normalize to “Add to cart”
  • Mobile Review: header fixed at top, summary footer (totals + Buy/Back) fixed at bottom, items scroll in between
  • Hide progress bar on Review step; no duplicate “Unlocked — …”
*/
{%- endcomment -%}

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css'       | asset_url | stylesheet_tag }}
{{ 'component-price.css'      | asset_url | stylesheet_tag }}
{{ 'quick-add.css'            | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Deals Drawer",
  "class": "section",
  "settings": [
    { "type":"text",   "id":"deal_message", "label":"Default message", "default":"Add items to unlock!" },

    { "type":"header", "content":"Deal checkpoints (optional)" },
    { "type":"number", "id":"deal1_count", "label":"Checkpoint 1 — items required", "default": 0 },
    { "type":"number", "id":"deal1_price", "label":"Checkpoint 1 — bundle price (₹)", "default": 0 },
    { "type":"number", "id":"deal2_count", "label":"Checkpoint 2 — items required (optional)", "default": 0 },
    { "type":"number", "id":"deal2_price", "label":"Checkpoint 2 — bundle price (₹) (optional)", "default": 0 },

    { "type":"checkbox", "id":"auto_advance", "label":"Auto-advance to next step when current step is complete", "default": true },
    { "type":"checkbox", "id":"enable_qty_selector", "label":"Enable quantity selector on selected cards", "default": true },
    { "type":"checkbox", "id": "show_step_counters", "default": true, "label": "Show step completion counters (x/y)" },
    { "type":"checkbox", "id":"enable_fly_anim", "label":"Enable fly-to-drawer animation", "default": true },
    { "type":"color", "id":"accent_color", "label":"Accent color", "default":"#111111" },

    { "type":"checkbox", "id":"show_secondary_image", "default": false, "label":"Show secondary image" },

    { "type":"checkbox", "id":"show_top_pills",       "default": true,  "label":"Show TOP pills & badges" },
    { "type":"checkbox", "id":"show_bottom_pills",    "default": true,  "label":"Show BOTTOM pills" },
    { "type":"checkbox", "id":"show_app_rating",      "default": true,  "label":"Show app rating widget (Judge.me)" },

    { "type":"select", "id":"columns_mobile", "default":"2", "label":"Mobile columns",
      "options":[{"value":"1","label":"1"},{"value":"2","label":"2"}] },
    { "type":"range", "id":"columns_desktop", "min":1,"max":6,"step":1,"default":4, "label":"Desktop columns" }
  ],
  "blocks": [
    {
      "type":"step",
      "name":"Bundle step",
      "settings": [
        { "type":"text", "id":"title", "label":"Step title", "default":"Step" },
        { "type":"textarea", "id":"note", "label":"Step helper text", "default":"Pick items from this collection." },
        { "type":"collection", "id":"step_collection", "label":"Step collection" },
        { "type":"number", "id":"required_count", "label":"Items required in this step", "default": 1 },
        { "type":"number", "id":"max_per_item", "label":"Max quantity per single item in this step (0 = no limit)", "default": 0 }
      ]
    }
  ],
  "presets": [{ "name":"Deals Drawer" }]
}
{% endschema %}


{% assign steps_count = section.blocks.size %}
{% assign total_required = 0 %}
{% for b in section.blocks %}{% assign total_required = total_required | plus: b.settings.required_count %}{% endfor %}

{% if steps_count > 0 %}
<div id="deal-section-{{ section.id }}" class="deal-section page-width"
     data-enable-qty="{{ section.settings.enable_qty_selector }}"
     style="--deal-accent: {{ section.settings.accent_color | default: '#111111' }}; --drawer-bg: rgba(255,255,255,.9); --drawer-border: rgba(0,0,0,.08); --chip-bg: rgba(0,0,0,.06); --text-weak: rgba(0,0,0,.65);">

<!-- TOP: Stepper -->
<ol class="deal-steps deal-steps--top" id="deal-steps-top-{{ section.id }}" role="tablist" aria-label="Bundle steps">
  {% for block in section.blocks %}
    {% assign _help  = block.settings.note  | strip %}
    <li
      class="deal-step-indicator{% if forloop.first %} active{% endif %}"
      data-step-index="{{ forloop.index0 }}"
      data-help="{{ _help | escape }}"
      role="tab"
      tabindex="0"
      aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
      <div class="label">Step {{ forloop.index }}</div>
    </li>
  {% endfor %}
  <li class="deal-step-indicator"
      data-step-index="review"
      data-help="Review your bundle and proceed to checkout."
      role="tab"
      tabindex="-1"
      aria-selected="false">
    <div class="label">Summary</div>
  </li>
</ol>

  <!-- Helper text under pills -->
  <div class="deal-step-help" id="deal-step-help-{{ section.id }}" aria-live="polite">
    {% assign first_help = section.blocks[0].settings.note | default: 'Pick items from this collection.' %}
    {{ first_help }}
  </div>


  <!-- Step grids -->
  {% for block in section.blocks %}
    {%- assign step_col = block.settings.step_collection -%}
    {% if step_col and step_col.products_count > 0 %}
      <ul
        class="grid product-grid
               grid--{{ section.settings.columns_mobile }}-col-tablet-down
               grid--{{ section.settings.columns_desktop }}-col-desktop
               step-grid{% unless forloop.first %} hidden{% endunless %}"
        data-step-index="{{ forloop.index0 }}"
        data-step-required="{{ block.settings.required_count }}"
        data-step-max-per-item="{{ block.settings.max_per_item | default: 0 }}"
        data-step-help="{{ block.settings.note | strip | escape }}"
        aria-label="Products for {% if block.settings.title != blank %}{{ block.settings.title }}{% else %}Step {{ forloop.index }}{% endif %}">
      {% for product in step_col.products %}

        {%- comment -%} First available variant + cents for Review pricing {%- endcomment -%}
        {% assign first_instock_id = nil %}
        {% assign first_instock_price_cents = 0 %}
        {% assign first_instock_compare_cents = 0 %}
        {% assign has_instock = false %}
        {% for v in product.variants %}
          {% if v.available %}
            {% assign first_instock_id = v.id %}
            {% assign first_instock_price_cents = v.price %}
            {% assign first_instock_compare_cents = v.compare_at_price | default: v.price %}
            {% assign has_instock = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% unless has_instock %}{% continue %}{% endunless %}

        <li class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %} data-cascade {% endif %}>
          <div
            class="deal-card"
            data-step-index="{{ forloop.parentloop.index0 }}"
            data-product-handle="{{ product.handle }}"
            data-product-id="{{ product.id }}"
            data-first-instock-id="{{ first_instock_id }}"
            data-first-price-cents="{{ first_instock_price_cents }}"
            data-first-compare-cents="{{ first_instock_compare_cents }}"
            {% unless section.settings.show_top_pills %}    data-hide-top-pills{% endunless %}
            {% unless section.settings.show_bottom_pills %} data-hide-bottom-pills{% endunless %}
            {% unless section.settings.show_app_rating %}   data-hide-rating{% endunless %}
          >
            {%- render 'card-product',
              card_product: product,
              show_secondary_image: section.settings.show_secondary_image,
              quick_add: 'standard',
              section_id: section.id
            -%}
          </div>
        </li>
      {% endfor %}
      </ul>
    {% else %}
      <p class="deal-empty-step">No products in “{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}Step {{ forloop.index }}{% endif %}”.</p>
    {% endif %}
  {% endfor %}

  <!-- Drawer -->
  <div id="deal-drawer-{{ section.id }}" class="deal-drawer deal-drawer--compact"
      data-total-required="{{ total_required }}"
      data-steps="{{ steps_count }}"
      data-auto-advance="{{ section.settings.auto_advance }}"
      data-enable-qty="{{ section.settings.enable_qty_selector }}"
      role="region" aria-live="polite" aria-label="Deal drawer">

    <div class="drawer-header">
      <div class="drawer-header__left">
        <span class="drawer-badge" id="drawer-badge-{{ section.id }}">0/{{ total_required }}</span>
        <span class="drawer-message">{{ section.settings.deal_message }}</span>
      </div>
      <div class="drawer-header__right">
        <button
          id="drawer-toggle-{{ section.id }}"
          class="drawer-toggle"
          aria-expanded="false"
          aria-controls="deal-drawer-{{ section.id }}"
          aria-label="Expand bundle drawer"
          title="Expand"
        >
          <!-- Chevron icon -->
          <svg class="drawer-toggle__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

    </div>

    <div class="drawer-progress" aria-hidden="true">
      <div class="drawer-progress-bar"><div class="drawer-progress-fill"></div></div>
    </div>

    <!-- Chips (hidden on Review) -->
    <div class="drawer-items" id="drawer-items-{{ section.id }}" aria-label="Selected items"></div>

    <!-- Summary (scroller on mobile in Review) -->
    <div id="drawer-summary-{{ section.id }}" class="drawer-summary hidden" aria-label="Bundle summary">

      <!-- (mobile-specific topbar not needed now, keep for future) -->
      <div id="summary-topbar-{{ section.id }}" class="summary-topbar hidden" aria-label="Summary navigation">
        <button id="summary-close-{{ section.id }}" class="drawer-nav secondary summary-topbar__back" aria-label="Back">Back</button>
        <div class="summary-topbar__title">Review your bundle</div>
        <div class="summary-topbar__spacer"></div>
      </div>

      <div class="summary-header">
        <div class="summary-title">Review your bundle</div>
        <div class="summary-meta">
          <span class="summary-savings hidden" id="summary-savings-{{ section.id }}">You save —</span>
        </div>
      </div>

      <div class="summary-layout">
        <div class="summary-lines" id="summary-items-{{ section.id }}"></div>

        <aside class="bill-card" aria-labelledby="summary-total-label-{{ section.id }}">
          <dl class="bill-grid">
            <div class="row"><dt>MRP Subtotal</dt><dd id="summary-mrp-subtotal-{{ section.id }}">—</dd></div>
            <div class="row"><dt>Sale Subtotal</dt><dd id="summary-sale-subtotal-{{ section.id }}">—</dd></div>
            <div class="row optional" id="deal-mrp-row-{{ section.id }}"><dt>Discount on MRP</dt><dd id="summary-discount-mrp-{{ section.id }}">—</dd></div>
            <div class="row optional" id="deal-discount-row-{{ section.id }}"><dt>Deal Discount</dt><dd id="summary-deal-discount-{{ section.id }}">—</dd></div>
            <hr class="divider" />
            <div class="row total"><dt id="summary-total-label-{{ section.id }}">Total</dt><dd id="summary-total-{{ section.id }}">—</dd></div>
          </dl>
          <p class="bill-note" id="bundle-note-{{ section.id }}" hidden>Bundle price applied. Taxes & shipping at checkout.</p>

          <!-- Actions: Shiprocket Headless (cart) + Back -->
          <div class="bill-actions">
            <div id="sr-headless-wrap-{{ section.id }}" class="sr-headless-wrap is-locked">
              <input type="hidden" value="true" id="fastrrCollectionPage">
              <input type="hidden" name="productUrl" value="{{ request.path | default: routes.root_url }}">
              <div class="shiprocket-headless" data-type="cart"></div>
            </div>
            <button id="summary-back-{{ section.id }}" class="drawer-nav secondary">Back</button>
          </div>
        </aside>
      </div>

      <!-- Legacy mobile sticky CTA (now disabled in fullscreen) -->
      <div id="summary-cta-mobile-{{ section.id }}" class="summary-cta-mobile hidden" aria-label="Checkout actions">
        <div class="summary-cta-mobile__total">
          <span>Total</span>
          <strong id="summary-total-mobile-{{ section.id }}">—</strong>
        </div>
        <div class="summary-cta-mobile__actions">
          <div id="sr-headless-wrap-mobile-{{ section.id }}" class="sr-headless-wrap is-locked">
            <input type="hidden" value="true" id="fastrrCollectionPageMobile">
            <input type="hidden" name="productUrl" value="{{ request.path | default: routes.root_url }}">
            <div class="shiprocket-headless" data-type="cart"></div>
          </div>
          <button id="summary-back-mobile-{{ section.id }}" class="drawer-nav secondary">Back</button>
        </div>
      </div>

    </div>

    <!-- Fixed Summary Footer (mobile fullscreen) -->
    <div id="summary-footer-{{ section.id }}" class="summary-footer hidden" aria-label="Order summary">
      <dl class="bill-grid">
        <div class="row"><dt>MRP Subtotal</dt><dd id="summary-mrp-subtotal-footer-{{ section.id }}">—</dd></div>
        <div class="row"><dt>Sale Subtotal</dt><dd id="summary-sale-subtotal-footer-{{ section.id }}">—</dd></div>
        <div class="row optional" id="deal-mrp-row-footer-{{ section.id }}"><dt>Discount on MRP</dt><dd id="summary-discount-mrp-footer-{{ section.id }}">—</dd></div>
        <div class="row optional" id="deal-discount-row-footer-{{ section.id }}"><dt>Deal Discount</dt><dd id="summary-deal-discount-footer-{{ section.id }}">—</dd></div>
        <hr class="divider" />
        <div class="row total"><dt>Total</dt><dd id="summary-total-footer-{{ section.id }}">—</dd></div>
      </dl>

      <div class="bill-actions">
        <div id="sr-headless-wrap-footer-{{ section.id }}" class="sr-headless-wrap is-locked">
          <input type="hidden" value="true" id="fastrrCollectionPageFooter">
          <input type="hidden" name="productUrl" value="{{ request.path | default: routes.root_url }}">
          <div class="shiprocket-headless" data-type="cart"></div>
        </div>
        <button id="summary-back-footer-{{ section.id }}" class="drawer-nav secondary">Back</button>
      </div>
    </div>


    <div class="drawer-actions" id="drawer-actions-{{ section.id }}">
      <button id="drawer-prev-{{ section.id }}" class="drawer-nav secondary{% if steps_count <= 1 %} hidden{% endif %}">Back</button>
      <button id="drawer-proceed-{{ section.id }}" class="drawer-proceed" disabled>Next step</button>
    </div>

    <div class="deal-toast" id="deal-toast-{{ section.id }}" hidden role="status">Step is full.</div>
  </div>

  <!-- Shiprocket prewarm host (always in DOM so widget can mount at idle) -->
  <div id="sr-prewarm-root-{{ section.id }}" class="sr-headless-wrap sr-prewarm" aria-hidden="true">
    <div class="shiprocket-headless" data-type="cart"></div>
  </div>

</div>
{% endif %}

<style>
/* ===== Utilities ===== */
.hidden { display: none; }

/* ===== Cart UI guards ===== */
.sr-headless-checkout { border-radius: 10px !important; }
#deal-section-{{ section.id }} ~ cart-drawer,
#deal-section-{{ section.id }} ~ cart-notification,
body[data-deals-active="1"]:not([data-deals-allow-cart="1"]) cart-drawer,
body[data-deals-active="1"]:not([data-deals-allow-cart="1"]) cart-notification {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}


/* ===== Global layout tweaks ===== */
@media (max-width: 749px) {
  .page-width { padding: 0 clamp(10px, -1.2px + 2.6667vw, 50px); }
}

.card--card { box-shadow: var(--kk__cs); }
.step-grid { column-gap: clamp(8px, 3.52px + 1.0667vw, 24px); row-gap: clamp(12px, 5.28px + 1.6vw, 36px); margin-top: 0; }

/* ===== Steps row (pills) ===== */
.deal-steps--top{
  display:flex; gap:clamp(6px, 3.48px + 0.6vw, 15px); margin:0; padding:0; padding-top:1rem; list-style:none; flex-wrap:wrap;
  justify-content:center; --deals-color:#00324C; font-size:clamp(12px, 10.88px + 0.2667vw, 16px);
}
.deal-step-indicator{
  display:flex; align-items:center; gap:.5rem; cursor:pointer; user-select:none;
  border:2px solid var(--deals-color);
  border-radius:clamp(5px, 3.6px + 0.3333vw, 10px);
  padding: clamp(2px, 1.44px + 0.1333vw, 4px) clamp(8px, 6.88px + 0.2667vw, 12px);
  background:transparent; color:var(--deals-color);
  transition:background .18s ease, color .18s ease, border-color .18s ease, transform .12s ease;
}
.deal-step-indicator .label{ white-space:nowrap; line-height: var(--line-height-x); }
.deal-step-indicator.active{ background:var(--deals-color); color:#fff; border-color:transparent; }
.deal-step-indicator:focus-visible{ outline:2px solid var(--deals-color); outline-offset:4px; }
.deal-step-indicator.locked{ opacity:.5; pointer-events:none; }
.deal-step-help{
  max-width: 68ch; margin-inline:auto; text-align:center; opacity:1;
  font-size: clamp(20px, 18.32px + 0.4vw, 26px); transform:translateY(0); transition:opacity .16s ease;
}
.deal-step-help.is-swapping{ opacity:0; }

/* ===== Drawer base ===== */
.deal-drawer{
  position:fixed; bottom:20px; z-index:101; left:var(--drawer-left,0px); width:var(--drawer-width,100vw);
  background:var(--drawer-bg); backdrop-filter:saturate(1.4) blur(10px);
  border-top:1px solid var(--drawer-border);
  border-radius:20px; box-shadow:0 0 20px rgba(0,0,0,.20); padding:25px;
  transform: translateZ(0); will-change: transform; contain: layout paint;
}
.drawer-header{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap}
.drawer-header__left{display:flex;align-items:center;gap:.6rem;min-width:200px}
.drawer-badge{background:var(--deal-accent);color:#fff;border-radius:10px;padding:.3rem .55rem;font-weight:800;letter-spacing:.3px}
.drawer-message{font-weight:600}
.drawer-progress-label{opacity:.75;min-width:180px;text-align:right}

/* ===== Progress ===== */
.drawer-progress-bar{height:10px;background:rgba(0,0,0,.06);border-radius:999px;overflow:hidden;margin:1.25rem 0;position:relative}
.deal-section .drawer-progress .drawer-progress-bar .drawer-progress-fill{
  display:block !important; height:100%; width:100%; background:var(--deal-accent);
  transform-origin:left center; transform:scaleX(var(--deal-pct, 0));
  transition:transform .45s cubic-bezier(.22,.8,.2,1); will-change:transform; position:relative; overflow:hidden;
}
.deal-section .drawer-progress .drawer-progress-bar .drawer-progress-fill.is-animating::after{
  content:''; position:absolute; top:0; bottom:0; width:40%; left:-40%;
  background:linear-gradient(90deg, rgba(255,255,255,.0), rgba(255,255,255,.35), rgba(255,255,255,0));
  filter:blur(2px); animation:deal-shimmer 800ms ease-out forwards; pointer-events:none;
}
@keyframes deal-shimmer { from { left:-40%; opacity:.85; } to { left:100%; opacity:0; } }
@supports not (transform: scaleX(0.5)) {
  .deal-section .drawer-progress .drawer-progress-bar .drawer-progress-fill{ width: calc(var(--deal-pct, 0) * 100%) !important; }
}
@media (prefers-reduced-motion: reduce) {
  .deal-section .drawer-progress .drawer-progress-bar .drawer-progress-fill { transition: none; }
  .deal-section .drawer-progress .drawer-progress-bar .drawer-progress-fill.is-animating::after{ display:none; }
}

/* ===== Drawer items (chips row) ===== */
.drawer-items{ display:flex; gap:1rem; min-height:86px; align-items:center; position:relative; transform:translateZ(0); will-change:transform; padding-bottom:15px; }
.drawer-items.hidden { margin: 0; min-height: 0; }
.drawer-item{ position:relative; flex:0 0 auto; isolation:isolate; }
.drawer-item img{ width:clamp(50px, 41.6px + 2vw, 80px); aspect-ratio:1; object-fit:cover; border-radius:10px; border:1px solid var(--drawer-border); background:#fff; }
.drawer-remove{
  position:absolute; top:-6px; right:-6px; width:22px; height:22px;
  border:none; border-radius:50%; background:#111; color:#fff; cursor:pointer; line-height:1; font-size:14px;
  box-shadow:0 4px 10px rgba(0,0,0,.15);
}
.drawer-item .chip-qty{
  position:absolute; bottom:-6px; right:-6px; min-width:22px; height:22px; padding:0 6px;
  display:grid; place-items:center; border-radius:999px; background:#111; color:#fff; font-size:12px; font-weight:800; line-height:1;
  box-shadow:0 4px 10px rgba(0,0,0,.15);
}

/* ===== Summary ===== */
.drawer-summary{max-height:42vh;overflow:auto;border-top:1px dashed rgba(0,0,0,.09);padding-top:.75rem;margin-top:.25rem}
.summary-header{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.6rem}
.summary-title{font-weight:700;font-size:1.5rem;letter-spacing:.2px}
.summary-meta{display:flex;gap:.5rem;align-items:center}
.summary-savings{background:var(--chip-bg);padding:5px 12px 3px 12px;border-radius:10px;font-weight:800}
.summary-group-label{ font-weight:800; letter-spacing:.2px; opacity:.8; margin:.75rem 0 .25rem; }

.summary-layout{display:grid;gap:2rem}
@media (min-width: 990px){ .summary-layout{grid-template-columns: 1fr minmax(300px, 380px)} }

.summary-lines{display:flex;flex-direction:column;gap:2rem}
.summary-lines .row{
  display:grid; grid-template-columns:1fr auto auto; gap:.75rem; align-items:center;
  padding:.5rem .25rem .55rem; border-bottom:1px dashed rgba(0,0,0,.08);
}
.summary-lines .row:last-child{ border-bottom:0; }
.summary-lines .meta{display:flex;align-items:center;gap:.75rem;min-width:0}
.summary-lines img{width:48px;height:48px;border-radius:10px;object-fit:cover;border:1px solid var(--drawer-border);background:#fff}
.summary-lines .line-title{ font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; max-width: 600px; }
.summary-lines .price{font-variant-numeric:tabular-nums; white-space:nowrap}
.summary-lines .price s{opacity:.55;margin-left:.35rem}
.summary-lines .summary-remove{border:none;background:var(--chip-bg);color:var(--deals-color);border-radius:10px;padding:.42rem .6rem;cursor:pointer;margin-top:.1rem}

/* Alt stacked price-under-title layout (kept as final override set) */
.summary-lines .row{
  grid-template-columns: 1fr auto;
  gap:.6rem;
}
.summary-lines .meta{
  display:grid; grid-template-columns:56px minmax(0,1fr); gap:.6rem; align-items:center; min-width:0;
}
.summary-lines img{
  width:56px; height:56px; border-radius:12px; object-fit:cover; border:1px solid var(--drawer-border); background:#fff;
}
.summary-lines .meta-text{ display:flex; flex-direction:column; gap:.2rem; min-width:0; }
.summary-lines .line-title{ font-size:16px; line-height:20px; font-weight:700; }
.summary-lines .price{ font-size:18px; font-weight:600; text-align:left; }
.summary-lines .price s{ font-size:14px; margin-left:.35rem; opacity:.55; }

.summary-lines .qty-badge{
  display:inline-block; margin-left:.5rem; padding:.5rem .65rem; border-radius:8px; background:var(--chip-bg);
