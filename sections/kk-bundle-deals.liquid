<script>
/* ===========================
   LIGHT CART BLOCKER (open only)
   =========================== */
(function () {
  try {
    document.documentElement.setAttribute('data-deals-active', '1');

    var CART = {
      allow: false,
      setAllow: function (on) {
        this.allow = !!on;
        if (this.allow) document.body.setAttribute('data-deals-allow-cart', '1');
        else document.body.removeAttribute('data-deals-allow-cart');
      }
    };
    CART.setAllow(false);

    var allow = function () { return !!CART.allow; };
    var getDrawer = function () { return document.querySelector('cart-drawer'); };
    var isDrawerActuallyOpen = function () {
      var d = getDrawer(); if (!d) return false;
      var cs = getComputedStyle(d);
      return (
        d.hasAttribute('open') ||
        d.classList.contains('is-open') ||
        d.classList.contains('drawer--is-open') ||
        (cs.display !== 'none' && cs.visibility !== 'hidden' && d.offsetHeight > 0)
      );
    };

    // Only suppress *open* events; let refresh/update/change flow to Dawn
    var killOpen = function (e) {
      try {
        if (allow()) return;
        e.stopImmediatePropagation();
        if (e.cancelable) e.preventDefault();
      } catch (_) {}
    };
    ['cart:open','cart-notification:show','cart-drawer:open'].forEach(function (evt) {
      document.addEventListener(evt, killOpen, true);
      window.addEventListener(evt,  killOpen, true);
    });

    // Patch only open/show/toggle (NOT renderContents)
    var patchTag = function (tag) {
      try {
        var C = window.customElements && window.customElements.get && window.customElements.get(tag);
        if (C && C.prototype && !C.prototype.__dealsPatchedV2) {
          ['open','show','toggle'].forEach(function (m) {
            if (typeof C.prototype[m] === 'function') {
              var orig = C.prototype[m];
              C.prototype[m] = function () { if (allow()) return orig.apply(this, arguments); };
            }
          });
          C.prototype.__dealsPatchedV2 = true;
        }
      } catch (_) {}
    };
    var ensure = function (tag) {
      if (window.customElements && !window.customElements.get(tag)) {
        try { window.customElements.whenDefined(tag).then(function(){ patchTag(tag); }); } catch(_){}
      } else { patchTag(tag); }
    };
    ensure('cart-drawer');
    ensure('cart-notification');

    // Don’t block clicks inside cart UI when not allowed (prevents accidental open)
    document.addEventListener('click', function (e) {
      var trg = e.target;
      if (!trg || !trg.closest) return;
      var insideCart = trg.closest('cart-drawer') || trg.closest('cart-notification');
      if (insideCart && !allow()) { killOpen(e); }
    }, true);

    function isHeaderCartToggle(el) {
      if (!el || !el.closest) return null;
      var btn = el.closest(
        '[data-cart-drawer-toggle], ' +
        '[aria-controls="cart-drawer"], ' +
        '.header__icon--cart, ' +
        'a[href="#cart-drawer"], ' +
        'button[name="cart"]'
      );
      return (btn && btn.closest('header, .header, .site-header')) ? btn : null;
    }

    // Helper to temporarily allow cart methods
    window.__dealsWithCartAllowed = function(fn) {
      var prev = CART.allow;
      CART.setAllow(true);
      try { fn && fn(); } finally { CART.setAllow(prev); }
    };

// Header cart click: allow + open + force fresh render twice (immediate + delayed)
document.addEventListener('click', function (e) {
  var btn = isHeaderCartToggle(e.target);
  if (!btn) return;

  CART.setAllow(true);
  try {
    var drawer = getDrawer();

    // Force a fresh read of server cart into Dawn drawer
    if (window.__dealsForceSyncAndRefreshDrawer && window.__dealsWithCartAllowed) {
      window.__dealsWithCartAllowed(() => window.__dealsForceSyncAndRefreshDrawer());
      // Safari/cookie settle fallback
      setTimeout(() => window.__dealsWithCartAllowed(() => window.__dealsForceSyncAndRefreshDrawer()), 250);
    }

    if (drawer) {
      drawer.dispatchEvent(new CustomEvent('cart:open', { bubbles: true, cancelable: true }));
      if (typeof drawer.open === 'function') drawer.open();
      else if (typeof drawer.show === 'function') drawer.show();
      else drawer.setAttribute('open','');
    } else {
      document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true, cancelable: true }));
    }
  } catch (_) {}
}, true);


    var mo = new MutationObserver(function () {
      CART.setAllow(isDrawerActuallyOpen());
    });
    var armObserver = function () {
      var d = getDrawer();
      if (!d) return;
      mo.disconnect();
      mo.observe(d, { attributes: true, attributeFilter: ['open','class','style'] });
      CART.setAllow(isDrawerActuallyOpen());
    };
    if (document.readyState !== 'loading') armObserver();
    else document.addEventListener('DOMContentLoaded', armObserver);

    var moRoot = new MutationObserver(armObserver);
    moRoot.observe(document.documentElement, { childList: true, subtree: true });

    ['cart:open','cart-drawer:open'].forEach(function (evt) {
      document.addEventListener(evt, function(){ CART.setAllow(true); }, true);
      window.addEventListener(evt, function(){ CART.setAllow(true); }, true);
    });

    ['cart:open','cart-drawer:open'].forEach(function(evt){
  document.addEventListener(evt, function(){
    if (!allow()) return;
    if (window.__dealsForceSyncAndRefreshDrawer && window.__dealsWithCartAllowed) {
      window.__dealsWithCartAllowed(() => window.__dealsForceSyncAndRefreshDrawer());
      setTimeout(() => window.__dealsWithCartAllowed(() => window.__dealsForceSyncAndRefreshDrawer()), 250);
    }
  }, true);

  window.addEventListener(evt, function(){
    if (!allow()) return;
    if (window.__dealsForceSyncAndRefreshDrawer && window.__dealsWithCartAllowed) {
      window.__dealsWithCartAllowed(() => window.__dealsForceSyncAndRefreshDrawer());
      setTimeout(() => window.__dealsWithCartAllowed(() => window.__dealsForceSyncAndRefreshDrawer()), 250);
    }
  }, true);
});

    ['cart:close','cart-drawer:close'].forEach(function (evt) {
      document.addEventListener(evt, function(){ CART.setAllow(false); }, true);
      window.addEventListener(evt, function(){ CART.setAllow(false); }, true);
    });
  } catch (_) {}
})();
</script>

<script>
/* Deals Drawer JS — compact build (qty-enabled, sync-safe) */
document.addEventListener('DOMContentLoaded', () => {
  const section = document.getElementById('deal-section-{{ section.id }}'); if (!section) return;

  /* ====== Consts / State ====== */
  const drawer       = document.getElementById('deal-drawer-{{ section.id }}');
  const itemsEl      = document.getElementById('drawer-items-{{ section.id }}');
  const proceedBtn   = document.getElementById('drawer-proceed-{{ section.id }}');
  const prevBtn      = document.getElementById('drawer-prev-{{ section.id }}');
  const summaryWrap  = document.getElementById('drawer-summary-{{ section.id }}');
  const actionsBar   = document.getElementById('drawer-actions-{{ section.id }}');
  const helpEl       = document.getElementById('deal-step-help-{{ section.id }}');
  const stepperTop   = document.getElementById('deal-steps-top-{{ section.id }}');
  const grids        = Array.from(section.querySelectorAll('.step-grid'));
  const badge        = document.getElementById('drawer-badge-{{ section.id }}');
  const drawerHeader = drawer.querySelector('.drawer-header');
  const drawerProgress = drawer.querySelector('.drawer-progress');
  const fill         = drawer.querySelector('.drawer-progress-fill');
  const progressLabel= document.getElementById('drawer-progress-label-{{ section.id }}');
  const drawerMsgEl  = drawer.querySelector('.drawer-message');
  const progBar      = drawer.querySelector('.drawer-progress-bar');

  const sumItems   = document.getElementById('summary-items-{{ section.id }}');
  const mrpSubEl   = document.getElementById('summary-mrp-subtotal-{{ section.id }}');
  const saleSubEl  = document.getElementById('summary-sale-subtotal-{{ section.id }}');
  const mrpDiscEl  = document.getElementById('summary-discount-mrp-{{ section.id }}');
  const dealDiscEl = document.getElementById('summary-deal-discount-{{ section.id }}');
  const totalEl    = document.getElementById('summary-total-{{ section.id }}');
  const savingsEl  = document.getElementById('summary-savings-{{ section.id }}');
  const bundleNote = document.getElementById('bundle-note-{{ section.id }}');
  const summaryFooter = document.getElementById('summary-footer-{{ section.id }}');
  const mrpSubElF  = document.getElementById('summary-mrp-subtotal-footer-{{ section.id }}');
  const saleSubElF = document.getElementById('summary-sale-subtotal-footer-{{ section.id }}');
  const mrpDiscElF = document.getElementById('summary-discount-mrp-footer-{{ section.id }}');
  const dealDiscElF= document.getElementById('summary-deal-discount-footer-{{ section.id }}');
  const totalElF   = document.getElementById('summary-total-footer-{{ section.id }}');
  const srWrapBill = document.getElementById('sr-headless-wrap-{{ section.id }}');
  const srWrapFooter = document.getElementById('sr-headless-wrap-footer-{{ section.id }}');
  const mobileCta  = document.getElementById('summary-cta-mobile-{{ section.id }}');
  const srWrapMobile = document.getElementById('sr-headless-wrap-mobile-{{ section.id }}');
  const totalMobile  = document.getElementById('summary-total-mobile-{{ section.id }}');
  const backMobile   = document.getElementById('summary-back-mobile-{{ section.id }}');
  const backFooterBtn= document.getElementById('summary-back-footer-{{ section.id }}');

  const ENABLE_FLY_ANIM = {{ section.settings.enable_fly_anim | default: false | json }};
  const stepsCount    = parseInt(drawer.dataset.steps || '0',10) || 0;
  const totalRequired = parseInt(drawer.dataset.totalRequired || '0',10) || 0;
  const AUTO_ADVANCE  = String(drawer.dataset.autoAdvance || drawer.dataset.auto_advance || '').toLowerCase() !== 'false';
  const ENABLE_QTY    = String(drawer.dataset.enableQty || drawer.dataset.enable_qty || '').toLowerCase() !== 'false';
  const REVIEW = 'review', INFLIGHT_TTL = 8000, __DEALS_SECTIONS = ['cart-drawer','cart-icon-bubble'];

  // === NEW: Two-tier checkpoint constants (prices in paise) ===
  const CP1_N = parseInt('{{ section.settings.deal1_count | default: 0 }}', 10) || 0;
  const CP1_P = Math.round((parseFloat('{{ section.settings.deal1_price | default: 0 }}') || 0) * 100);
  const CP2_N = parseInt('{{ section.settings.deal2_count | default: 0 }}', 10) || 0;
  const CP2_P = Math.round((parseFloat('{{ section.settings.deal2_price | default: 0 }}') || 0) * 100);
  const hasCP1 = CP1_N > 0 && CP1_P > 0;
  const hasCP2 = CP2_N > 0 && CP2_P > 0 && CP2_N > CP1_N;

  const stepRequired = grids.map(g => parseInt(g.dataset.stepRequired || '0',10) || 0);
  const stepMaxPerItemRaw = grids.map(g => parseInt(g.dataset.stepMaxPerItem || '0',10) || 0);
  const perItemLimit = i => (stepMaxPerItemRaw[i]||0) > 0 ? stepMaxPerItemRaw[i] : Infinity;

  // Decide if a card should show qty widget (vs just keep Add button)
  function setCardQtyMode(card, stepIdx) {
    const allow = ENABLE_QTY && perItemLimit(stepIdx) > 1;
