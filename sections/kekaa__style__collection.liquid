<style>
/* Outfit-Style Collections — rebuilt for Mastt.
   The previous build needed three uploaded artwork files per tile (leaf
   shape, static badge icon, rotating text SVG). None of those exist in
   this store, so every tile rendered as a "No image" placeholder.
   This version needs nothing but an optional photo: the tile shape, the
   accent ring and the label are all drawn in CSS/text, so it looks
   finished on day one and the label is real selectable text. */

.shopify-section:has(.style-collection) .kk__wrapper{
  padding-block: calc(var(--spacer) / 2);
  max-width: clamp(300px, 80px + 68.75vw, 1400px);
}

.style-collection .kk__heading{
  display: none;
}

.style-collection {
  --tile-gap: clamp(14px, 10px + 1.2vw, 26px);

  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--tile-gap);
  place-content: center;
  align-items: stretch;

  position: relative;
  max-width: clamp(300px, calc(100% - 120px), 900px);
  width: 100%;
  margin: 0 auto;
}

/* ---- Tile ---- */
.style-collection__leaf {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  text-decoration: none;

  background-color: var(--color-nude-beige, #E3C4BC);
  background-image: var(--leaf-image, linear-gradient(150deg, var(--color-nude-beige, #E3C4BC), var(--color-blush-pink, #EC9F93)));
  background-repeat: no-repeat;
  background-size: var(--bg-size, cover);
  background-position: var(--focus-x, 50%) var(--focus-y, 50%);

  box-shadow: var(--shadow-sm, 0 1px 2px rgba(32,27,25,.1));
  transition: transform 420ms cubic-bezier(.16,1,.3,1),
              box-shadow 420ms cubic-bezier(.16,1,.3,1);
}

.style-collection__leaf:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg, 0 20px 48px -8px rgba(32,27,25,.22));
}

/* Petal geometry — each tile rounds hard on its outer corner and gently
   on the three facing the centre, so the four together read as a flower. */
.style-collection__leaf.pos--tl { border-radius: 60% 18px 18px 18px; }
.style-collection__leaf.pos--tr { border-radius: 18px 60% 18px 18px; }
.style-collection__leaf.pos--bl { border-radius: 18px 18px 18px 60%; }
.style-collection__leaf.pos--br { border-radius: 18px 18px 60% 18px; }

/* Scrim keeps the label legible over any uploaded photo */
.style-collection__leaf::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(to top, rgba(32,27,25,.72) 0%, rgba(32,27,25,.10) 52%, rgba(32,27,25,0) 100%);
}

/* ---- Label ---- */
.style-collection__label {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 0 12px clamp(16px, 10px + 1.4vw, 28px);
  text-align: center;
}

.style-collection__label-title {
  font-family: var(--font-heading-family);
  font-style: italic;
  font-weight: 500;
  font-size: clamp(16px, 13px + 1vw, 24px);
  line-height: 1.2;
  color: var(--color-pearl-beige, #F5E7DF);
  text-shadow: 0 2px 12px rgba(32,27,25,.45);
}

.style-collection__label-cta {
  display: inline-block;
  font-family: var(--font-body-family);
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: var(--tracking-wider, .14em);
  color: var(--color-charcoal, #201B19);
  background: var(--tile-accent, var(--color-dusty-coral, #D6887C));
  padding: 5px 12px;
  border-radius: var(--radius-full, 999px);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 320ms cubic-bezier(.16,1,.3,1),
              transform 320ms cubic-bezier(.16,1,.3,1);
}

.style-collection__leaf:hover .style-collection__label-cta,
.style-collection__leaf:focus-visible .style-collection__label-cta {
  opacity: 1;
  transform: translateY(0);
}

/* Accent ring hugging the outer petal curve, cycling the secondary palette */
.style-collection__leaf::before {
  content: '';
  position: absolute;
  inset: 10px;
  z-index: 2;
  pointer-events: none;
  border: 1.5px solid var(--tile-accent, var(--color-dusty-coral, #D6887C));
  border-radius: inherit;
  opacity: .55;
  transition: opacity 320ms ease, inset 420ms cubic-bezier(.16,1,.3,1);
}

.style-collection__leaf:hover::before {
  opacity: 1;
  inset: 7px;
}

.style-collection__leaf.pos--tl { --tile-accent: var(--color-dusty-coral, #D6887C); }
.style-collection__leaf.pos--tr { --tile-accent: var(--color-aqua, #78AAB1); }
.style-collection__leaf.pos--bl { --tile-accent: var(--color-blush-pink, #EC9F93); }
.style-collection__leaf.pos--br { --tile-accent: var(--color-nude-beige, #E3C4BC); }

/* ---- Centre medallion ---- */
.style-collection__heading {
  display: none;
}

@media screen and (min-width: 769px) {
  .style-collection__heading{
    display: grid;
    place-items: center;

    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(180px, 150px + 6vw, 260px);
    aspect-ratio: 1;
    z-index: 3;

    border-radius: 50%;
    background: var(--color-white, #fff);
    box-shadow: var(--shadow-lg, 0 20px 48px -8px rgba(32,27,25,.22));

    font-family: var(--font-heading-family);
    font-style: italic;
    text-align: center;
    padding: 18px;
  }

  .style-collection__heading h2{
    font-size: clamp(22px, 18px + 0.9vw, 32px);
    max-width: 12ch;
    margin: 0;
  }
}

@media screen and (max-width: 768px) {
  .kk__wrapper:has(.style-collection) .kk__heading{
    display: block;
    margin-bottom: 20px;
    margin-block-start: 0;
  }

  .style-collection{
    grid-template-columns: 1fr 1fr;
    max-width: 100%;
  }

  /* Softer, uniform petals once the centre medallion is gone */
  .style-collection__leaf.pos--tl,
  .style-collection__leaf.pos--tr,
  .style-collection__leaf.pos--bl,
  .style-collection__leaf.pos--br { border-radius: 40% 40% 16px 16px; }
}
</style>

<div class="kk__wrapper">
  <h2 class="kk__heading">{{ section.settings.heading_text }}</h2>

  <section class="style-collection">

    <div class="style-collection__heading">
      <h2>{{ section.settings.heading_text }}</h2>
    </div>

    {% for block in section.blocks %}
      {%- liquid
        assign pos = block.settings.position | default: 'tl'
        assign label = block.settings.label | default: 'Shop the edit'
      -%}
      <a
        href="{{ block.settings.badge_link }}"
        class="style-collection__leaf pos--{{ pos }}"
        {{ block.shopify_attributes }}
        style="
          {% if block.settings.leaf_shape != blank %}--leaf-image: url({{ block.settings.leaf_shape | image_url: width: 800 }});{% endif %}
          --bg-size: {% if block.settings.leaf_shape != blank %}{{ block.settings.bg_size | default: 150 }}%{% else %}cover{% endif %};
          --focus-x: {{ block.settings.focus_x | default: 50 }}%;
          --focus-y: {{ block.settings.focus_y | default: 50 }}%;
        "
      >
        <span class="style-collection__label">
          <span class="style-collection__label-title">{{ label }}</span>
          <span class="style-collection__label-cta">Shop now</span>
        </span>
      </a>
    {% endfor %}
  </section>
</div>


{% schema %}
{
  "name": "Outfit Style Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Outfit‐Style Collections"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Style Tile (4 Total)",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Grid Position",
          "options": [
            { "value": "tl", "label": "Top Left" },
            { "value": "tr", "label": "Top Right" },
            { "value": "bl", "label": "Bottom Left" },
            { "value": "br", "label": "Bottom Right" }
          ],
          "default": "tl"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Shown on the tile, e.g. Daily Wear",
          "default": "Daily Wear"
        },
        {
          "type": "image_picker",
          "id": "leaf_shape",
          "label": "Tile photo",
          "info": "Optional. Falls back to a brand gradient if left empty."
        },
        {
          "type": "url",
          "id": "badge_link",
          "label": "Click-through URL"
        },
        {
          "type": "range",
          "id": "bg_size",
          "label": "Photo zoom (%)",
          "min": 100,
          "max": 300,
          "step": 10,
          "unit": "%",
          "default": 150
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Photo focus X-axis (%)",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y",
          "label": "Photo focus Y-axis (%)",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Style Collection",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
