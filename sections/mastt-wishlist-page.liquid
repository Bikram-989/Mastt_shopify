{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<mastt-wishlist-page id="Wish-{{ section.id }}" class="page-width mwp">
  <header class="mwp__head">
    <div>
      <p class="mwp__eyebrow">Your personal edit</p>
      <h1 class="mwp__heading">{{ section.settings.heading | escape }}</h1>
      <p class="mwp__intro">The pieces you keep coming back to. Saved in this browser.</p>
    </div>
    <span class="mwp__count" data-mwp-count>0 pieces</span>
  </header>
  <p class="mwp__status" data-mwp-status role="status" aria-live="polite"></p>
  <button type="button" class="button button--secondary" data-mwp-retry hidden>Try again</button>
  <ul class="mwp__grid" role="list" data-mwp-grid hidden></ul>
  <div class="mwp__empty" data-mwp-empty>
    <span class="mwp__heart" aria-hidden="true">♡</span>
    <h2>A little space for your favourites</h2>
    <p>Tap the heart on a piece you love. Find it here whenever you’re ready.</p>
    <a class="button" data-mwp-browse href="{{ routes.all_products_collection_url }}">Find your next favourite</a>
  </div>
  <noscript><p>Enable JavaScript to view the pieces saved in this browser.</p></noscript>
</mastt-wishlist-page>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Saved for you" }]
}
{% endschema %}
