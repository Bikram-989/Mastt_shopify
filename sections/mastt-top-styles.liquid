{%- comment -%}
  Mastt Top Styles — tabbed product rail.

  Each block is a tab. A tab points at a collection and, optionally, narrows it
  by product type and/or tag so a single "all products" collection can feed
  every tab without the merchant creating a collection per category.

  All tabs render server-side and are toggled with a tiny bit of JS, so the
  products are in the HTML for crawlers and the tab switch costs no request.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<style>
  #TopStyles-{{ section.id }} {
    position: relative;
    isolation: isolate;
    padding-block: calc(var(--spacer) / 2);
  }

  {%- comment -%}
    Background band. Set explicitly per section rather than inferred from
    which sections happen to sit next to each other: an adjacency rule breaks
    silently the moment the page is reordered in Theme Editor.

    "Top half" and "Bottom half" are two halves of one gradient. They must meet
    exactly — an overlap paints both semi-transparent layers over each other
    and shows as a dark strip, a gap shows as a light one. So the top half
    ends at its own bottom edge, the bottom half starts at its own top edge,
    and each kills the wrapper padding on the side where they join.
  {%- endcomment -%}
  {%- if section.settings.band != 'none' -%}
    {%- case section.settings.band -%}
      {%- when 'top' -%}
        #shopify-section-{{ section.id }} { padding-bottom: 0 !important; }
      {%- when 'bottom' -%}
        #shopify-section-{{ section.id }} { padding-top: 0 !important; }
    {%- endcase -%}

    #TopStyles-{{ section.id }}::before {
      content: '';
      position: absolute;
      z-index: -1;
      left: -1.1rem;
      right: -1.1rem;
      border-inline: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
      {%- case section.settings.band -%}
        {%- when 'top' -%}
          top: -10px;
          bottom: 0;
          border-radius: var(--radius-lg) var(--radius-lg) 0 0;
          border-top: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
          background: linear-gradient(180deg,
            color-mix(in srgb, var(--color-blush-pink) 22%, transparent) 0%,
            color-mix(in srgb, var(--color-nude-beige) 26%, transparent) 100%);
        {%- when 'bottom' -%}
          top: 0;
          bottom: -10px;
          border-radius: 0 0 var(--radius-lg) var(--radius-lg);
          border-bottom: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
          background: linear-gradient(180deg,
            color-mix(in srgb, var(--color-nude-beige) 26%, transparent) 0%,
            color-mix(in srgb, var(--color-aqua) 18%, transparent) 100%);
        {%- when 'full' -%}
          inset: -10px -1.1rem;
          border-radius: var(--radius-lg);
          border-block: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
          background: linear-gradient(180deg,
            color-mix(in srgb, var(--color-blush-pink) 22%, transparent) 0%,
            color-mix(in srgb, var(--color-aqua) 18%, transparent) 100%);
      {%- endcase -%}
    }

    {%- comment -%}
      The tab section pads itself with calc(--spacer / 2), which at the top of
      that clamp is 48px. Halved on the joining side so the two halves sit
      close enough to read as one band.
    {%- endcomment -%}
    {%- comment -%}
      Inside a band the section's own calc(--spacer / 2) is too much air: the
      band already separates this block from what is above it, so the padding
      was doing the same job twice.
    {%- endcomment -%}
    #TopStyles-{{ section.id }} {
      padding-top: clamp(12px, 8px + 0.8vw, 18px);
      {%- if section.settings.band == 'top' -%}
        padding-bottom: clamp(14px, 10px + 1vw, 22px);
      {%- elsif section.settings.band == 'bottom' -%}
        padding-top: clamp(10px, 7px + 0.7vw, 16px);
      {%- endif -%}
    }
  {%- endif -%}

  /* ---- Tab strip -------------------------------------------------------
     Mobile leads: one scrollable row rather than a wrapping block, so a long
     tab list never pushes the products below the fold. Bleeds to the screen
     edge so the last pill is visibly cut off — that is the affordance telling
     you there is more to the right. */
  #TopStyles-{{ section.id }} .mts__tabs {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 8px;
    margin: 0 0 20px;
    padding: 2px 1.5rem;
    margin-inline: -1.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #TopStyles-{{ section.id }} .mts__tabs::-webkit-scrollbar { display: none; }

  #TopStyles-{{ section.id }} .mts__tab {
    appearance: none;
    cursor: pointer;
    flex: 0 0 auto;
    scroll-snap-align: start;
    border: 1px solid var(--color-charcoal, #201B19);
    background: transparent;
    color: var(--color-charcoal, #201B19);
    border-radius: var(--radius-full, 999px);
    padding: 0.8rem 1.6rem;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: var(--tracking-wide, .08em);
    transition: background-color 180ms var(--ease-out, ease),
                color 180ms var(--ease-out, ease),
                border-color 180ms var(--ease-out, ease);
  }

  #TopStyles-{{ section.id }} .mts__tab[aria-selected='true'] {
    background: var(--color-charcoal, #201B19);
    border-color: var(--color-charcoal, #201B19);
    color: var(--color-pearl-beige, #F5E7DF);
  }

  @media (hover: hover) {
    #TopStyles-{{ section.id }} .mts__tab:hover {
      border-color: var(--color-dusty-coral, #D6887C);
    }
  }

  #TopStyles-{{ section.id }} .mts__panel[hidden] { display: none; }

  /* ---- Product rail ----------------------------------------------------
     A horizontal rail on mobile, sized so roughly two and a bit cards show.
     The partial third card is deliberate: a card cut by the screen edge reads
     as scrollable, where a neat row of two reads as finished. */
  #TopStyles-{{ section.id }} .mts__grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    list-style: none;
    padding: 0 1.5rem 4px;
    margin: 0 -1.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline-start: 1.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #TopStyles-{{ section.id }} .mts__grid::-webkit-scrollbar { display: none; }

  #TopStyles-{{ section.id }} .mts__grid > li {
    flex: 0 0 clamp(150px, 43vw, 210px);
    scroll-snap-align: start;
  }

  /* Desktop returns to a static grid — there is room for the whole row and a
     scroll rail on a mouse is worse than seeing everything at once. */
  @media screen and (min-width: 990px) {
    #TopStyles-{{ section.id }} .mts__tabs {
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(8px, 5px + 0.6vw, 14px);
      overflow-x: visible;
      margin-inline: 0;
      padding-inline: 0;
      margin-bottom: clamp(24px, 16px + 1.6vw, 40px);
    }

    #TopStyles-{{ section.id }} .mts__tab {
      padding: 0.9rem 2rem;
      font-size: 1.2rem;
      text-transform: uppercase;
    }

    #TopStyles-{{ section.id }} .mts__grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: clamp(14px, 9px + 1.2vw, 28px);
      overflow-x: visible;
      margin: 0;
      padding: 0;
    }

    #TopStyles-{{ section.id }} .mts__grid > li { flex: initial; }
  }

  #TopStyles-{{ section.id }} .mts__empty {
    flex: 1 0 100%;
    text-align: center;
    padding: clamp(28px, 20px + 2vw, 56px) 16px;
    border: 1px dashed var(--color-charcoal-15, rgba(32,27,25,.15));
    border-radius: var(--radius-md, 16px);
    color: var(--color-charcoal-70, #6B5F5B);
    font-size: 1.4rem;
  }

  #TopStyles-{{ section.id }} .mts__viewall {
    display: flex;
    justify-content: center;
    margin-top: clamp(20px, 14px + 1.2vw, 40px);
  }

  /* Dawn's secondary button borrows the scheme's button colour for its
     outline, which on this tinted band came out barely visible. */
  #TopStyles-{{ section.id }} .mts__viewall .button--secondary {
    box-shadow: 0 0 0 1px var(--color-charcoal, #201B19);
    border: 0;
    color: var(--color-charcoal, #201B19);
    background: transparent;
  }

  @media (hover: hover) {
    #TopStyles-{{ section.id }} .mts__viewall .button--secondary:hover {
      background: var(--color-charcoal, #201B19);
      color: var(--color-pearl-beige, #F5E7DF);
    }
  }
</style>

<div id="TopStyles-{{ section.id }}" class="mastt-top-styles kk__wrapper page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="kk__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="mts__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Product categories' | escape }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="mts__tab"
          role="tab"
          id="MtsTab-{{ section.id }}-{{ forloop.index0 }}"
          aria-controls="MtsPanel-{{ section.id }}-{{ forloop.index0 }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign source = block.settings.collection
        comment
          Falls back to the whole catalogue so a tab still fills before the
          merchant picks a collection (and because the "all" handle does not
          always resolve to a real collection object).
        endcomment
        if source == blank or source.products_count == 0
          assign source = collections.all
        endif
        comment
          Both accept a comma-separated list, so one tab can straddle a
          taxonomy migration (e.g. "women, her") without the rail going empty
          the moment the data changes underneath it.
        endcomment
        assign want_types = block.settings.product_type | downcase | split: ','
        assign want_tags = block.settings.tag | downcase | split: ','
        assign limit = section.settings.products_to_show
        assign shown = 0

        assign view_all = block.settings.view_all_url
        if view_all == blank
          assign view_all = source.url
        endif
      -%}

      <div
        class="mts__panel"
        id="MtsPanel-{{ section.id }}-{{ forloop.index0 }}"
        role="tabpanel"
        aria-labelledby="MtsTab-{{ section.id }}-{{ forloop.index0 }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <ul class="mts__grid">
          {%- for product in source.products -%}
            {%- liquid
              assign ok = true

              if want_types.size > 0
                assign ptype = product.type | downcase | strip
                assign type_ok = false
                for wanted in want_types
                  assign wanted_clean = wanted | strip
                  if wanted_clean != blank and ptype == wanted_clean
                    assign type_ok = true
                  endif
                endfor
                unless type_ok
                  assign ok = false
                endunless
              endif

              if want_tags.size > 0
                assign has_tag = false
                for t in product.tags
                  assign t_down = t | downcase | strip
                  for wanted in want_tags
                    assign wanted_clean = wanted | strip
                    if wanted_clean != blank and t_down == wanted_clean
                      assign has_tag = true
                    endif
                  endfor
                endfor
                unless has_tag
                  assign ok = false
                endunless
              endif
            -%}
            {%- if ok and shown < limit -%}
              {%- assign shown = shown | plus: 1 -%}
              <li>
                {%- render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  show_secondary_image: section.settings.show_secondary_image,
                  quick_add: section.settings.quick_add,
                  section_id: section.id
                -%}
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- if shown == 0 -%}
            <li class="mts__empty">Nothing here yet — new pieces landing soon.</li>
          {%- endif -%}
        </ul>

        {%- if section.settings.show_view_all and view_all != blank -%}
          <div class="mts__viewall">
            <a href="{{ view_all }}" class="button button--secondary">
              {{ section.settings.view_all_label | default: 'View all' | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('TopStyles-{{ section.id }}');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('.mts__tab'));

    function select(index) {
      tabs.forEach(function (tab, i) {
        var on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { select(i); });
      tab.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') next = 0;
        if (e.key === 'End') next = tabs.length - 1;
        if (next === null) return;
        e.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Mastt Top Styles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mastt Top Styles"
    },
    {
      "type": "select",
      "id": "band",
      "label": "Background band",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "top",
          "label": "Top half of a pair"
        },
        {
          "value": "bottom",
          "label": "Bottom half of a pair"
        },
        {
          "value": "full",
          "label": "Whole band"
        }
      ],
      "default": "none",
      "info": "Two stacked sections set to Top half and Bottom half share one continuous gradient."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products per tab",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "default": "View all"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "All"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Source collection",
          "info": "Usually your full catalogue — narrow it with the filters below."
        },
        {
          "type": "text",
          "id": "product_type",
          "label": "Only show this product type",
          "info": "Optional. Comma-separate to accept several, e.g. Ring, Rings."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Only show products with this tag",
          "info": "Optional. Comma-separate to accept several, e.g. women, her."
        },
        {
          "type": "url",
          "id": "view_all_url",
          "label": "\"View all\" link",
          "info": "Defaults to the source collection if left empty."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Mastt Top Styles",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
