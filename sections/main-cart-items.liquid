  @media (max-width: 749px) {
    .template-cart #MainContent { padding: 24px 16px 32px; gap: 20px; }
    .template-cart .cart-items tbody tr { border: 1px solid #e9ded7; border-radius: 16px; padding: 16px; margin-bottom: 14px; gap: 14px; }
    .template-cart .cart-items td { padding: 0; border: 0; }
    .template-cart .cart-items td:first-child,
    .template-cart .cart-items td:last-child { padding: 0; border: 0; }
