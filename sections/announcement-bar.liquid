{% comment %}
Announcement Bar Section with Marquee Scrolling Text
Features:
- Scroll On/Off toggle
- Direction (left→right or right→left)
- Speed control
- Custom text & background colors
- Custom separator symbol
- Pause on hover option
- Each announcement is a block with text + optional link
{% endcomment %}

{% style %}
.announcement-marquee {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  overflow: hidden;
  white-space: nowrap;
  padding: 0.15em 0;

  a{
    font-size: clamp(12px, 11.5385px + 0.1282vw, 14px); 
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }
}
.announcement-marquee__inner {
  display: inline-block;
  padding-left: 100%;
  {% if section.settings.scroll_enabled %}
  animation-name: marquee;
  animation-timing-function: linear;
  animation-duration: {{ section.settings.speed }}s;
  animation-iteration-count: infinite;
  animation-direction: {% if section.settings.direction == 'rtl' %}reverse{% else %}normal{% endif %};
  {% endif %}
}
.announcement-item {
  display: inline-block;
  margin-right: 0.5em;
}
.announcement-separator {
  display: inline-block;
  margin: 0 0.5em;
}
{% if section.settings.pause_on_hover and section.settings.scroll_enabled %}
.announcement-marquee:hover .announcement-marquee__inner {
  animation-play-state: paused;
}
{% endif %}
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
{% endstyle %}

{% if section.blocks.size > 0 %}
  <div class="announcement-marquee{% unless section.settings.scroll_enabled %} no-scroll{% endunless %}" role="region" aria-label="Announcements">
    <div class="announcement-marquee__inner">
      {% for block in section.blocks %}
        <span class="announcement-item">
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="announcement-link">
              {{ block.settings.text | escape }}
            </a>
          {% else %}
            {{ block.settings.text | escape }}
          {% endif %}
        </span>
        {% unless forloop.last %}
          <span class="announcement-separator">{{ section.settings.separator }}</span>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Mastt Announcement Bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
      "id": "scroll_enabled",
      "label": "Enable Scrolling",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "ltr", "label": "Left → Right" },
        { "value": "rtl", "label": "Right → Left" }
      ],
      "default": "rtl"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds)",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 20
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator Symbol",
      "default": "•"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201B19"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EC9F93"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message Text",
          "default": "New Collection Launching Soon!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar (Marquee)",
      "category": "Header",
      "blocks": [ { "type": "announcement" } ]
    }
  ]
}
{% endschema %}
