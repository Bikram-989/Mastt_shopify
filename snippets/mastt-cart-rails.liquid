{%- comment -%}
  Recently Viewed and Loved by You Guys, for the cart drawer.

  Sections cannot be rendered inside a snippet, and the drawer is a snippet,
  so this is a compact rail of its own rather than the homepage sections. Both
  rails reuse card-product, so cards look and behave the same as everywhere
  else — including the + and the heart.

  Recently Viewed reads the same localStorage key as the homepage rail and
  fetches through the Section Rendering API. It hides itself when a visitor
  has no history, so a first-time cart never shows an empty shelf.
{%- endcomment -%}

{%- liquid
  comment
    The drawer is a snippet, so there is no `section` here to read a setting
    from. Sorting is owned by the collection itself: point cart_rail_collection
    at a collection sorted by Best selling and this rail ranks from real orders.
  endcomment
  assign loved = collections[settings.cart_rail_collection]
  if loved == blank or loved.products_count == 0
    assign loved = collections.all
  endif
-%}

<div class="mcr" data-mcr-rv hidden>
  <h3 class="mcr__head">Recently viewed</h3>
  <ul class="mcr__rail" role="list" data-mcr-rv-rail></ul>
</div>

{%- if loved.products.size > 0 -%}
  <div class="mcr">
    <h3 class="mcr__head">Loved by You Guys</h3>
    <ul class="mcr__rail" role="list">
      {%- assign skip = false -%}
      {%- for product in loved.products limit: 8 -%}
        <li>
          {%- render 'card-product',
            card_product: product,
            media_aspect_ratio: 'square',
            show_secondary_image: false,
            show_vendor: false,
            show_rating: false,
            quick_add: 'none',
            section_id: 'cart-drawer-rail',
            skip_styles: skip
          -%}
        </li>
        {%- assign skip = true -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

<script>
  (function () {
    var root = document.querySelector('[data-mcr-rv]');
    if (!root) return;
    var rail = root.querySelector('[data-mcr-rv-rail]');

    var handles;
    try {
      var raw = window.localStorage.getItem('mastt:recently-viewed');
      handles = raw ? JSON.parse(raw) : [];
      if (!Array.isArray(handles)) handles = [];
    } catch (e) { return; }

    handles = handles.filter(function (h) { return typeof h === 'string' && h; }).slice(0, 8);
    if (!handles.length) return;

    var parser = new DOMParser();
    Promise.all(handles.map(function (handle) {
      return fetch('/products/' + encodeURIComponent(handle) + '?section_id=mastt-rv-card')
        .then(function (r) { return r.ok ? r.text() : null; })
        .then(function (html) {
          if (!html) return null;
          var doc = parser.parseFromString(html, 'text/html');
          return doc.querySelector('.card-wrapper') || doc.querySelector('.card');
        })
        .catch(function () { return null; });
    })).then(function (cards) {
      var placed = 0;
      cards.forEach(function (card) {
        if (!card) return;      // deleted or unpublished since it was viewed
        var li = document.createElement('li');
        li.appendChild(card);
        rail.appendChild(li);
        placed++;
      });
      if (placed) root.hidden = false;
    });
  })();
</script>
