{%- liquid
  assign category_links = section.settings.mastt_category_menu.links
  assign cat_handles = 'rings,necklaces,bracelets,earrings,sets,anklets' | split: ','
  assign new_arrivals_source = section.settings.mastt_new_arrivals.handle | default: 'new-arrivals'
  assign her_source = section.settings.mastt_for_her.handle | default: 'for-her'
  assign him_source = section.settings.mastt_for_him.handle | default: 'for-him'
  assign best_source = section.settings.mastt_best_sellers.handle | default: 'best-sellers'
  assign tabs = 'Category,New Arrivals,For Her,For Him,Best Seller' | split: ','
-%}
<header-drawer data-breakpoint="tablet">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>
        <span class="svg-wrapper">{{ 'icon-hamburger.svg' | inline_asset_content }}</span>
        <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce mmd" tabindex="-1">
      <div class="menu-drawer__inner-container mmd__panel">
        <mastt-menu-tabs class="mmd__body">
          <ul class="mmd__rail" role="tablist" aria-label="Browse by" aria-orientation="vertical">
            {%- for tab in tabs -%}
              <li role="presentation">
                <button type="button" class="mmd__tab" role="tab" id="MmdTab-{{ forloop.index0 }}" aria-controls="MmdPanel-{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ tab }}</button>
              </li>
            {%- endfor -%}
          </ul>
          <div class="mmd__panes">
            <div class="mmd__pane" id="MmdPanel-0" role="tabpanel" aria-labelledby="MmdTab-0">
              <p class="mmd__eyebrow">Find your everyday favourite</p>
              <ul class="mmd__grid" role="list">
                {%- if category_links.size > 0 -%}
                  {%- for category in category_links -%}
                    {%- if category.type == 'collection_link' -%}
                      {%- render 'mastt-menu-category', collection: category.object, label: category.title -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for handle in cat_handles -%}
                    {%- assign category = collections[handle] -%}
                    {%- if category != blank -%}
                      {%- render 'mastt-menu-category', collection: category -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
              <a class="mmd__viewall" href="{{ routes.all_products_collection_url }}">Explore all pieces <span aria-hidden="true">↗</span></a>
            </div>
            {%- render 'mastt-menu-pane', idx: 1, source: new_arrivals_source -%}
            {%- render 'mastt-menu-pane', idx: 2, source: her_source -%}
            {%- render 'mastt-menu-pane', idx: 3, source: him_source -%}
            {%- render 'mastt-menu-pane', idx: 4, source: best_source -%}
          </div>
        </mastt-menu-tabs>
        <nav class="mmd__foot" aria-label="Helpful links">
          <a href="{{ routes.root_url }}pages/wishlist">Saved pieces</a>
          <a href="{{ routes.root_url }}pages/contact">Contact</a>
          <a href="{{ routes.root_url }}pages/about-mastt">Our story</a>
        </nav>
      </div>
    </div>
  </details>
</header-drawer>
