{% comment %}
  ============================================================
  MASTT — Custom Mobile Mega Menu
  File: snippets/kekaa-mobile-menu.liquid (filename kept as-is; internal only)

  HOW TO INSTALL:
  1. In Shopify Admin → Online Store → Themes → Edit Code
  2. Create a new file under snippets/ named: kekaa-mobile-menu.liquid
  3. Paste this entire file into it
  4. Open sections/header.liquid and find the line that renders
     the mobile drawer (look for <details id="Details-menu-drawer")
     Replace it with: {% render 'kekaa-mobile-menu' %}
  5. Optionally remove the Navi Plus app from your theme.liquid
     to stop loading its JS bundle.
  ============================================================
{% endcomment %}

{% comment %} ── DATA: Edit your nav items here ── {% endcomment %}
{% assign menu_tabs = "Shop,Collections,Styles,Mastt Cares" | split: "," %}

<style>
  /* ── Reset & base ───────────────────────────────────────── */
  #kk-menu-overlay,
  #kk-menu-drawer,
  #kk-menu-drawer * {
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Overlay ────────────────────────────────────────────── */
  #kk-menu-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 9998;
    transition: opacity 0.25s ease;
    opacity: 0;
  }
  #kk-menu-overlay.kk-open {
    display: block;
    opacity: 1;
  }

  /* ── Drawer shell ───────────────────────────────────────── */
  #kk-menu-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: min(88vw, 420px);
    height: 100dvh;
    background: #fff;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    font-family: inherit;
  }
  #kk-menu-drawer.kk-open {
    transform: translateX(0);
  }

  /* ── Header bar ─────────────────────────────────────────── */
  .kk-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #f0f0f0;
    flex-shrink: 0;
  }
  .kk-drawer-logo {
    height: 32px;
    width: auto;
  }
  .kk-drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
    color: #222;
    border-radius: 50%;
    transition: background 0.15s;
  }
  .kk-drawer-close:hover { background: #f5f5f5; }
  .kk-drawer-close svg { width: 20px; height: 20px; }

  /* ── Tabs ───────────────────────────────────────────────── */
  .kk-tabs {
    display: flex;
    border-bottom: 1px solid #f0f0f0;
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .kk-tabs::-webkit-scrollbar { display: none; }
  .kk-tab {
    flex: 1;
    min-width: max-content;
    padding: 13px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #888;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: 0.03em;
    transition: color 0.15s, border-color 0.15s;
  }
  .kk-tab.kk-active {
    color: #1a1a1a;
    border-bottom-color: #1a1a1a;
  }

  /* ── Scrollable body ────────────────────────────────────── */
  .kk-drawer-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .kk-drawer-body::-webkit-scrollbar { display: none; }

  /* ── Tab panels ─────────────────────────────────────────── */
  .kk-panel {
    display: none;
    padding: 0;
  }
  .kk-panel.kk-active { display: block; }

  /* ── PANEL 1: Shop by Category (grid tiles like Palmonas) ── */
  .kk-section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #999;
    padding: 18px 20px 10px;
  }

  .kk-category-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #f0f0f0;
    margin: 0 0 1px;
  }
  .kk-cat-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    padding: 16px 14px 16px 18px;
    text-decoration: none;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
    min-height: 72px;
    transition: background 0.12s;
  }
  .kk-cat-tile:hover { background: #fafafa; }
  .kk-cat-tile-name {
    flex: 1;
    line-height: 1.35;
    padding-right: 8px;
  }
  .kk-cat-tile-img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 4px;
  }
  .kk-cat-tile-placeholder {
    width: 52px;
    height: 52px;
    background: #f8f8f8;
    border-radius: 4px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kk-cat-tile-placeholder svg {
    width: 28px;
    height: 28px;
    opacity: 0.18;
  }
  .kk-view-all {
    display: block;
    text-align: center;
    padding: 14px;
    font-size: 13px;
    color: #555;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Expandable category with sub-links ─────────────────── */
  .kk-accordion {
    border-bottom: 1px solid #f0f0f0;
  }
  .kk-accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 20px;
    background: none;
    border: none;
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
    cursor: pointer;
    text-align: left;
  }
  .kk-accordion-toggle svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform 0.2s;
    color: #aaa;
  }
  .kk-accordion-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .kk-accordion-body {
    display: none;
    padding: 0 20px 12px 20px;
  }
  .kk-accordion-body.kk-open { display: block; }
  .kk-sub-link {
    display: block;
    padding: 8px 0 8px 12px;
    font-size: 13px;
    color: #555;
    text-decoration: none;
    border-left: 2px solid #f0f0f0;
    margin-bottom: 2px;
    transition: color 0.1s, border-color 0.1s;
  }
  .kk-sub-link:hover {
    color: #1a1a1a;
    border-left-color: #1a1a1a;
  }

  /* ── Simple link list (Collections, Styles, Cares) ──────── */
  .kk-link-list {
    padding: 8px 0;
  }
  .kk-link-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    font-size: 14px;
    color: #1a1a1a;
    text-decoration: none;
    border-bottom: 1px solid #f9f9f9;
    transition: background 0.12s;
  }
  .kk-link-item:hover { background: #fafafa; }
  .kk-link-item svg {
    width: 16px;
    height: 16px;
    color: #ccc;
    flex-shrink: 0;
  }

  /* ── Material pills row ─────────────────────────────────── */
  .kk-material-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 4px 20px 16px;
  }
  .kk-pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid #e0e0e0;
    font-size: 12px;
    color: #444;
    text-decoration: none;
    transition: background 0.12s, border-color 0.12s;
    white-space: nowrap;
  }
  .kk-pill:hover {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
  }

  /* ── Footer account/social strip ───────────────────────── */
  .kk-drawer-footer {
    border-top: 1px solid #f0f0f0;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background: #fafafa;
  }
  .kk-footer-account {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #555;
    text-decoration: none;
  }
  .kk-footer-account svg { width: 18px; height: 18px; }
  .kk-footer-social {
    display: flex;
    gap: 12px;
  }
  .kk-footer-social a {
    display: flex;
    color: #666;
    transition: color 0.15s;
  }
  .kk-footer-social a:hover { color: #1a1a1a; }
  .kk-footer-social svg { width: 18px; height: 18px; }

  /* ── Hamburger button (replaces Dawn's) ─────────────────── */
  #kk-hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: inherit;
  }
  #kk-hamburger svg { width: 22px; height: 22px; }

  @media (min-width: 750px) {
    #kk-hamburger { display: none; }
    #kk-menu-overlay,
    #kk-menu-drawer { display: none !important; }
  }
</style>

{%- comment -%} ── Hamburger trigger (insert where Dawn's burger button is) {%- endcomment -%}
<button id="kk-hamburger" aria-label="Open menu" aria-controls="kk-menu-drawer" aria-expanded="false">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
    <line x1="3" y1="6" x2="21" y2="6"/>
    <line x1="3" y1="12" x2="21" y2="12"/>
    <line x1="3" y1="18" x2="21" y2="18"/>
  </svg>
</button>

{%- comment -%} ── Overlay ── {%- endcomment -%}
<div id="kk-menu-overlay" aria-hidden="true"></div>

