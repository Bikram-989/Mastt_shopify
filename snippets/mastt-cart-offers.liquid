{%- comment -%}
  Offers, applied through real Shopify discount codes.

  Every tier is always listed. Below its threshold a row is locked and says
  what is still needed; at or above it, Apply links to
  /discount/CODE?redirect=/cart, which is Shopify's own mechanism — the code
  lands on the cart and carries through to checkout.

  Worth knowing: Shopify accepts one order-level code at a time, so applying a
  lower tier while a higher one is also unlocked takes the smaller saving.
  Both are offered because the choice is the customer's to make.

  Codes are used rather than automatic discounts on purpose. Shopify applies
  only one order-class automatic discount per order, so three overlapping
  automatic tiers cannot be relied on to resolve to the right one. A code the
  customer applies is explicit, visible in the summary, and enforced by
  Shopify's own minimum-purchase rule — so the cart cannot promise a saving
  that checkout then refuses.

  Accepts:
  - tiers_json: {String} JSON array of { min, off, code }
{%- endcomment -%}

{%- liquid
  assign tiers = tiers_json | replace: '},{', '}|{' | split: '|'
  assign total = cart.total_price

  assign applied_titles = ''
  for d in cart.cart_level_discount_applications
    assign applied_titles = applied_titles | append: d.title | append: ','
  endfor
-%}

{%- if tiers.size > 0 -%}
  <div class="moff">
    <div class="moff__head">
      <span class="moff__icon" aria-hidden="true">%</span>
      <div>
        <p class="moff__title">Offers</p>
        <p class="moff__sub">One offer applies per order</p>
      </div>
    </div>

    <ul class="moff__list" role="list">
      {%- for raw in tiers -%}
        {%- liquid
          assign row = raw | remove: '[' | remove: ']' | remove: '{' | remove: '}' | remove: '"'
          assign parts = row | split: ','
          assign tmin = 0
          assign toff = 0
          assign tcode = ''
          for part in parts
            assign kv = part | split: ':'
            assign k = kv[0] | strip
            assign v = kv[1] | strip
            case k
              when 'min'
                assign tmin = v | plus: 0
              when 'off'
                assign toff = v | plus: 0
              when 'code'
                assign tcode = v
            endcase
          endfor
          assign unlocked = false
          if total >= tmin
            assign unlocked = true
          endif
          assign is_on = false
          if tcode != blank and applied_titles contains tcode
            assign is_on = true
          endif
          assign gap = tmin | minus: total
        -%}

        {%- if toff > 0 -%}
          <li class="moff__row{% unless unlocked %} is-locked{% endunless %}{% if is_on %} is-applied{% endif %}">
            <label class="moff__pick">
              {%- comment -%}
                A radio rather than an Apply button per row: only one code can
                be on the order, so picking one has to visibly deselect the
                others. Locked rows are disabled instead of hidden, so the
                ladder above the current spend stays readable.
              {%- endcomment -%}
              <input
                type="radio"
                name="mastt-offer"
                class="moff__radio"
                value="{{ tcode | escape }}"
                data-code="{{ tcode | escape }}"
                {% unless unlocked %}disabled{% endunless %}
                {% if is_on %}checked{% endif %}
              >
              <span class="moff__dot" aria-hidden="true"></span>

              <span class="moff__body">
                <span class="moff__name">{{ toff | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs', '₹' | replace: '₹ ', '₹' }} off</span>
                <span class="moff__note">
                  {%- if is_on -%}
                    Applied to this order
                  {%- elsif unlocked -%}
                    On orders over {{ tmin | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs', '₹' | replace: '₹ ', '₹' }}
                  {%- else -%}
                    Add {{ gap | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: 'Rs', '₹' | replace: '₹ ', '₹' }} more to unlock
                  {%- endif -%}
                </span>
              </span>

              {%- if is_on -%}
                <span class="moff__state">Applied</span>
              {%- elsif unlocked == false -%}
                <span class="moff__state moff__state--locked" aria-hidden="true">Locked</span>
              {%- endif -%}
            </label>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <a class="moff__apply" href="#" data-moff-apply aria-disabled="true">Apply offer</a>
    <p class="moff__hint" data-moff-hint>Select an unlocked offer to apply it.</p>
  </div>

  <script>
    (function () {
      var box = document.currentScript.closest('.moff');
      if (!box) return;

      var apply = box.querySelector('[data-moff-apply]');
      var hint = box.querySelector('[data-moff-hint]');

      function sync() {
        var picked = box.querySelector('.moff__radio:checked:not([disabled])');
        if (picked && picked.dataset.code) {
          apply.setAttribute('href', '/discount/' + encodeURIComponent(picked.dataset.code) + '?redirect=/cart');
          apply.removeAttribute('aria-disabled');
          hint.hidden = true;
        } else {
          /* No href at all, so a disabled control cannot be followed. */
          apply.removeAttribute('href');
          apply.setAttribute('aria-disabled', 'true');
          hint.hidden = false;
        }
      }

      box.addEventListener('change', function (e) {
        if (e.target.classList.contains('moff__radio')) sync();
      });

      apply.addEventListener('click', function (e) {
        if (apply.getAttribute('aria-disabled') === 'true') e.preventDefault();
      });

      sync();
    })();
  </script>
{%- endif -%}
